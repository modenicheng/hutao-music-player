{
  "name": "hmp-tauri",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc --noEmit && vite build",
    "test": "vitest run",
    "sidecar:prepare:debug": "node ./scripts/prepare-sidecar.mjs debug",
    "sidecar:prepare:release": "node ./scripts/prepare-sidecar.mjs release",
    "sidecar:stage": "powershell -NoProfile -ExecutionPolicy Bypass -File ./scripts/stage-sidecar.ps1",
    "tauri:build:windows": "pnpm tauri build",
    "preview": "vite preview",
    "tauri": "node ./scripts/tauri.mjs"
  },
  "dependencies": {
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-opener": "^2",
    "vue": "^3.5.13",
    "vue-router": "^5.2.0"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2",
    "@vitejs/plugin-vue": "^5.2.1",
    "typescript": "~5.6.2",
    "vite": "^6.0.3",
    "vitest": "^4.1.10",
    "vue-tsc": "^2.1.10"
  }
}
