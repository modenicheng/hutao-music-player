// 下载（DownloadsView.vue，v0.13）：已下载曲目表 → 落盘明细（一行一事的发丝线
// 定义行：存储位置 / 下载音质（读真实偏好）+ 在设置中调整 text-link）。
// 后端尚无下载域（docs/AUDIT.md M8 记录）→ 诚实空态，不虚构曲目。
import { Theme } from "theme.slint";
import { Icons } from "icons.slint";
import { AppIcon, Button, ButtonVariant } from "primitives.slint";
import { FactRow, PageHeader, SectionHeader } from "page-parts.slint";
import { TrackTable } from "track-table.slint";
import { Nav, Route } from "nav.slint";
import { Data, Player, Quality } from "stores.slint";

export component DownloadsPage inherits Rectangle {
    background: transparent;

    VerticalLayout {
        padding-top: Theme.space-6;
        padding-left: Theme.space-8;
        padding-right: Theme.space-8;
        padding-bottom: Theme.space-10;
        spacing: Theme.space-8;

        PageHeader {
            title: "下载音乐";
            show-back: true;
            back => {
                Nav.navigate(Route.library, "");
            }
            meta-items: Data.downloads-count == 0 ? ["0 首"] : [
                "\{Data.downloads-count} 首",
                "占用 \{Data.downloads-size}",
                "含无损 \{Data.downloads-lossless} 首",
            ];

            Button {
                variant: ButtonVariant.default;
                small: true;
                icon: Icons.play_arrow;
                icon-size: 17.6px;
                text: "播放全部";
                enabled: Data.downloads-count > 0;
                height: 32px;
                clicked => {
                    Player.play-tracks(Data.downloads, 0);
                }
            }
        }

        if Data.downloads-count == 0: VerticalLayout {
            spacing: Theme.space-4;

            SectionHeader {
                title: "已下载";
            }
            Rectangle {
                height: 168px;
                border-radius: Theme.radius-lg;
                background: Theme.surface-3;

                VerticalLayout {
                    alignment: center;
                    spacing: Theme.space-2;

                    HorizontalLayout {
                        alignment: center;

                        AppIcon {
                            source: Icons.download;
                            icon-color: Theme.muted-foreground;
                            width: 32px;
                            height: 32px;
                        }
                    }
                    Text {
                        text: "还没有下载内容";
                        color: Theme.foreground;
                        font-size: 13.5px;
                        horizontal-alignment: center;
                    }
                    Text {
                        text: "在线下载尚未开放；本地音乐请到「音乐库」查看。";
                        color: Theme.muted-foreground;
                        font-size: 12.8px;
                        horizontal-alignment: center;
                    }
                }
            }
        }

        if Data.downloads-count > 0: VerticalLayout {
            spacing: Theme.space-8;

            // —— 已下载 ——
            VerticalLayout {
                spacing: Theme.space-3;

                SectionHeader {
                    title: "已下载";
                }
                TrackTable {
                    tracks: Data.downloads;
                    show-header: true;
                }
            }

            // —— 落盘明细：编辑部式定义行 ——
            VerticalLayout {
                spacing: Theme.space-3;

                SectionHeader {
                    title: "落盘明细";
                }
                FactRow {
                    label: "存储位置";
                    value: Data.downloads-storage-path;
                }
                FactRow {
                    label: "下载音质";
                    value: Quality.tier-label(Quality.selected);
                    with-adjust-link: true;
                    adjust-link-clicked => {
                        Nav.navigate(Route.settings-playback, "");
                    }
                }
            }
        }
    }
}
