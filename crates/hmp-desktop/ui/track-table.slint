// 曲目表（TrackTable.vue，DESIGN.md §3.0）：序号/标题+歌手/专辑/时长。
// 整行点击 → 替换队列并从该行播放；当前行 equalizer + 标题 accent；
// 行 hover 用 HoverGroup 滑动高亮（中性底）；播放图标经 indicator 槽随块
// 纵向滑入序号位（不逐行 fade），EQ 优先级最高。
import { Theme } from "theme.slint";
import { Icons } from "icons.slint";
import { AppIcon, Equalizer, HoverGroup, HoverItem, TextLink } from "primitives.slint";
import { TrackRow } from "data.slint";
import { Viewport } from "viewport.slint";
import { Nav, Route } from "nav.slint";
import { Player } from "stores.slint";
import { TrackMenu, MenuContext, TrackMenuPanel } from "context-menu.slint";

export component TrackTable inherits Rectangle {
    in property <[TrackRow]> tracks;
    in property <bool> show-header: false;
    in property <bool> show-album: true;
    /** 时长未知的数据源（如 smartbox 搜索结果）置 false → 显示 "—" 而非 0:00 */
    in property <bool> show-duration: true;

    background: transparent;
    horizontal-stretch: 1;

    property <length> row-height: 39px;

    // —— 窗口化虚拟化（MEMFIX ④a，Viewport 全局）———
    // 本组件可能深埋页面布局，直接读父级几何必成环；改经 app.slint 顶层
    // Scroll 写入的 Viewport 全局做窗口换算，本组件只读。
    property <length> row-pitch: root.row-height + 2px;
    property <int> overscan: 8;
    // 视口顶在内容系的 y（scroll-offset 恒 ≤ 0）
    property <length> visible-top: -Viewport.y;
    // 表顶在内容系的 y：absolute-position 是窗口系且含滚动偏移（活依赖），
    // 减 origin-y 与 Viewport.y 恰好抵消滚动位移——结果为恒定内容坐标，
    // 逐帧自动重算
    property <length> table-top: self.absolute-position.y - Viewport.origin-y - Viewport.y;
    // 可见窗首行绝对索引与行数。view-h <= 0（TestingBackend/无头环境未绑定
    // Viewport）时全量渲染，退化为旧的常驻实例化行为。依赖链单向：窗口量
    // 只依赖 Viewport 与模型长度；下方行容器高度只依赖模型长度——绝不反向
    // 掺入窗口变量，否则与 Viewport.y 绑定成环。
    property <int> window-start: Viewport.view-h <= 0px ? 0
        : clamp(
            Math.floor((visible-top - table-top) / row-pitch) - overscan,
            0,
            max(tracks.length - 1, 0),
        );
    property <int> window-count: Viewport.view-h <= 0px ? tracks.length
        : min(
            tracks.length - window-start,
            Math.ceil(Viewport.view-h / row-pitch) + 2 * overscan,
        );

    // Vue 网格一次定列（2.5rem | 1.4fr | 0.8fr | 4rem，gap 16px，行内距 12px）：
    // Slint 每行是独立布局，stretch 会按各行内容首选宽漂移，必须按根宽算定宽。
    // 收起的列连带少一个 gap，按实际可见列数算（与下方列定义同一开关），
    // 死减满配 gap 会把标题列挤窄出死区
    property <length> grid-available: self.width - 24px - 40px
        - (root.show-duration ? 64px : 0px)
        - Theme.space-4 * (1 + (root.show-album ? 1 : 0) + (root.show-duration ? 1 : 0));
    property <length> title-w: root.show-album ? grid-available * 1.4 / 2.2 : grid-available;
    property <length> album-w: grid-available * 0.8 / 2.2;

    function format-duration(ms: int) -> string {
        if (ms <= 0) {
            return "0:00";
        }
        // 对齐 TS 版 Math.round(ms/1000) 秒
        return Math.mod(Math.round(ms / 1000), 60) < 10
            ? "\{Math.floor(Math.round(ms / 1000) / 60)}:0\{Math.mod(Math.round(ms / 1000), 60)}"
            : "\{Math.floor(Math.round(ms / 1000) / 60)}:\{Math.mod(Math.round(ms / 1000), 60)}";
    }

    VerticalLayout {
        spacing: 2px;

        if show-header && tracks.length > 0: Rectangle {
            height: root.row-height;

            HorizontalLayout {
                padding-left: 12px;
                padding-right: 12px;
                spacing: Theme.space-4;

                Text {
                    width: 40px;
                    text: "#";
                    color: Theme.muted-foreground;
                    font-size: 12.5px;
                    vertical-alignment: center;
                }
                Text {
                    width: root.title-w;
                    text: "标题";
                    color: Theme.muted-foreground;
                    font-size: 12.5px;
                    vertical-alignment: center;
                }
                if root.show-album: Text {
                    width: root.album-w;
                    text: "专辑";
                    color: Theme.muted-foreground;
                    font-size: 12.5px;
                    vertical-alignment: center;
                }
                if root.show-duration: Text {
                    width: 64px;
                    text: "时长";
                    color: Theme.muted-foreground;
                    font-size: 12.5px;
                    horizontal-alignment: right;
                    vertical-alignment: center;
                }
            }
        }

        hg := HoverGroup {
            highlight-color: Theme.neutral-200;
            highlight-opacity: 0.6;
            indicator-icon: Icons.play_arrow;
            indicator-x: 12px;
            indicator-width: 40px;
            indicator-icon-size: 16px;
            indicator-align-start: true;
            // 高度必须显式钉住：hg 是根布局子元素，普通 Rectangle 子元素的
            // 显式 height 不进 preferred 链（repeater 无固有尺寸）→ 布局把
            // hg 压成 0 高 + clip → 整表不可见不可点（截图实测）。旧写法的
            // VerticalLayout 子元素会主动上报 preferred 高度，故无此问题。
            height: tracks.length > 0 ? tracks.length * row-pitch - 2px : 0px;

            // 行窗口容器：固定高只依赖模型长度（N×行距 − 末行后无 spacing），
            // 行按绝对索引绝对定位。宽度必须显式钉住：非布局父级下默认宽由
            // 子 preferred 宽推导，而行 width=parent.width 反向引用容器 →
            // 循环解出 0 宽 → 整表不可命中（drag 回归实测）。整表占位高度
            // 与旧全量实例化一致，Scroll 内容高度/滚动条几何不变；只实例化
            // 可见窗（window-count）行。
            Rectangle {
                x: 0;
                width: parent.width;
                height: tracks.length > 0 ? tracks.length * row-pitch - 2px : 0px;

                // 整数即模型（Slint 无 `0..N` 区间 for）：offset ∈ 0..window-count
                for offset in root.window-count: hover-item := HoverItem {
                    group-id: hg.group-id;
                    x: 0;
                    width: parent.width;
                    height: root.row-height;
                    y: (root.window-start + offset) * root.row-pitch;
                    // 行数据经命名属性取模型绝对行（loop 变量 offset 只是窗口内
                    // 序号；`row` 名在 for 体内不可作属性名，改 rowd）
                    property <TrackRow> rowd: root.tracks[root.window-start + offset];
                    suppress-indicator: Player.queue-current-mid == rowd.mid;
                    clicked => {
                        Player.play-tracks(root.tracks, root.window-start + offset);
                    }
                    // —— 统一右键菜单（全局开关 TrackMenu.enabled 闸）———
                    // 快照带绝对下标（虚拟化：窗口内 offset 不可作下标用）与
                    // 整表模型引用（播放语义零拷贝）；歌单详情页 context 换挡。
                    // 打开坐标走 TrackMenu global（popup 自有属性禁止外层访问）
                    context-enabled: TrackMenu.enabled;
                    context-requested(mx, my) => {
                        TrackMenu.context = Nav.route == Route.playlist
                            ? MenuContext.playlist : MenuContext.library;
                        TrackMenu.index = root.window-start + offset;
                        TrackMenu.track = rowd;
                        TrackMenu.source-list = root.tracks;
                        TrackMenu.open-x = mx;
                        TrackMenu.open-y = my;
                        row-menu.show();
                    }

                    HorizontalLayout {
                        padding-left: 12px;
                        padding-right: 12px;
                        spacing: Theme.space-4;

                        // 序号位：当前行显示跳动条；hover 行让位给 indicator 的播放图标
                        Rectangle {
                            width: 40px;

                            Equalizer {
                                paused: !Player.playing;
                                x: 0;
                                y: (parent.height - self.height) / 2;
                                visible: Player.queue-current-mid == rowd.mid;
                            }
                            Text {
                                text: "\{root.window-start + offset + 1}";
                                color: Theme.muted-foreground;
                                font-size: 13.6px;
                                vertical-alignment: center;
                                x: 0;
                                width: parent.width;
                                visible: Player.queue-current-mid != rowd.mid;
                                opacity: hover-item.hovered ? 0 : 1;
                                animate opacity {
                                    duration: Theme.duration-fast;
                                    easing: cubic-bezier(0.2, 0, 0, 1);
                                }
                            }
                        }

                        // 标题 + 歌手（歌手整体一个链接 → 主歌手页）
                        Rectangle {
                            width: root.title-w;

                            HorizontalLayout {
                                spacing: 6px;
                                alignment: LayoutAlignment.start;

                                title-text := Text {
                                    text: rowd.title;
                                    color: Player.queue-current-mid == rowd.mid ? Theme.track-accent : Theme.foreground;
                                    font-size: 15.2px;
                                    font-weight: Player.queue-current-mid == rowd.mid ? 650 : 400;
                                    vertical-alignment: center;
                                    overflow: elide;
                                }
                                Text {
                                    text: rowd.artists;
                                    color: Theme.muted-foreground;
                                    font-size: 12.8px;
                                    vertical-alignment: center;
                                    overflow: elide;
                                    horizontal-stretch: 1;
                                }
                            }

                            // 歌手名 hover 提亮 + 跳转（覆盖在文本上）；
                            // 无参数（QQ 行远端 mid 缺失/无歌手数据）→ 链接禁用
                            TouchArea {
                                x: title-text.width + 6px;
                                width: parent.width - self.x;
                                enabled: rowd.artist-mid != "";
                                mouse-cursor: rowd.artist-mid != "" ? pointer : default;
                                clicked => {
                                    Nav.navigate(Route.artist, rowd.artist-mid);
                                }
                                // 启用的 TouchArea 对所有按键 grab（会吞右键）：
                                // 右键释放转发给行宿主打开菜单，坐标经窗口系
                                // absolute-position 差值换算回行内
                                pointer-event(event) => {
                                    if (event.kind == PointerEventKind.up
                                        && event.button == PointerEventButton.right) {
                                        hover-item.context-requested(
                                            self.absolute-position.x - hover-item.absolute-position.x + self.mouse-x,
                                            self.absolute-position.y - hover-item.absolute-position.y + self.mouse-y,
                                        );
                                    }
                                }
                            }
                        }

                        // 专辑（可点跳专辑页；窄窗由 show-album 收起；
                        // 无参数 → 退化纯文本，不渲染死链接）
                        if root.show-album && rowd.album-mid != "": TextLink {
                            width: root.album-w;
                            // 撑满行高：TextLink 组件内固定高 20px 会被行布局
                            // 顶对齐（交叉轴默认顶对齐），专辑文字随之上浮。
                            // 不能写 parent.height（布局子元素引用父高成环）
                            height: root.row-height;
                            text: rowd.album;
                            font-size: 13.4px;
                            context-enabled: true;
                            clicked => {
                                Nav.navigate(Route.album, rowd.album-mid);
                            }
                            // 行内链接右键转发（坐标换算同上：absolute 差值 + 链接内偏移）
                            context-requested(lx, ly) => {
                                hover-item.context-requested(
                                    self.absolute-position.x - hover-item.absolute-position.x + lx,
                                    self.absolute-position.y - hover-item.absolute-position.y + ly,
                                );
                            }
                        }
                        if root.show-album && rowd.album-mid == "": Text {
                            width: root.album-w;
                            text: rowd.album;
                            color: Theme.muted-foreground;
                            font-size: 13.4px;
                            vertical-alignment: center;
                            overflow: elide;
                        }

                        // 时长列与表头同一开关：数据源无时长（如 smartbox 搜索）整列收起，
                        // 不再渲染右缘 64px 的 "—"；条件元素在布局里须显式几何
                        if root.show-duration: Text {
                            width: 64px;
                            height: root.row-height;
                            text: root.format-duration(rowd.duration-ms);
                            color: Theme.muted-foreground;
                            font-size: 13.4px;
                            horizontal-alignment: right;
                            vertical-alignment: center;
                        }
                    }

                    // 行锚定菜单弹层：编译期 PopupWindow 从元素树摘除（不参与
                    // 布局/hover），坐标相对本行、show 时钳制进窗口、滚动跟随锚、
                    // 行卸载自动关；点外/ESC 关闭走 CloseOnClickOutside 默认策略。
                    // 内容面板读 TrackMenu 全局快照——每行一个实例，仅 show 的生效
                    row-menu := PopupWindow {
                        x: TrackMenu.open-x;
                        y: TrackMenu.open-y + 4px;
                        width: 216px;
                        height: menu-panel.height;

                        menu-panel := TrackMenuPanel {
                            dismissed => {
                                row-menu.close();
                            }
                        }
                    }
                }
            }
        }

        if tracks.length == 0: Text {
            height: 64px;
            text: "这里还没有歌曲";
            color: Theme.muted-foreground;
            horizontal-alignment: center;
            vertical-alignment: center;
        }
    }
}
