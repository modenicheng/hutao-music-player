// 曲目表（TrackTable.vue，DESIGN.md §3.0）：序号/标题+歌手/专辑/时长。
// 整行点击 → 替换队列并从该行播放；当前行 equalizer + 标题 accent；
// 行 hover 用 HoverGroup 滑动高亮（中性底）；播放图标经 indicator 槽随块
// 纵向滑入序号位（不逐行 fade），EQ 优先级最高。
// 键盘（M7 焦点可达，roving 光标）：整张表一个 Tab 停靠点——↑/↓ 移动光标行
// （滚动跟随）、←/→ 在行内切换「行 / 歌手链接 / 专辑链接」子光标、Enter/空格
// 激活。不让每行进 Tab 链：窗口化虚拟化只实例化一窗行，Tab 走不到窗外的行。
import { Theme } from "theme.slint";
import { Icons } from "icons.slint";
import { AppIcon, Equalizer, HoverGroup, HoverItem, KeyTouch, ListKeys, TextLink } from "primitives.slint";
import { TrackRow } from "data.slint";
import { Viewport } from "viewport.slint";
import { Nav, Route } from "nav.slint";
import { Player } from "stores.slint";
import { TrackMenu, MenuContext, TrackMenuPanel } from "context-menu.slint";

export component TrackTable inherits Rectangle {
    in property <[TrackRow]> tracks;
    in property <bool> show-header: false;
    in property <bool> show-album: true;
    /** 时长未知的数据源（如 smartbox 搜索结果）置 false → 显示 "—" 而非 0:00 */
    in property <bool> show-duration: true;

    background: transparent;
    horizontal-stretch: 1;

    property <length> row-height: 39px;

    // —— 窗口化虚拟化（MEMFIX ④a，Viewport 全局）———
    // 本组件可能深埋页面布局，直接读父级几何必成环；改经 app.slint 顶层
    // Scroll 写入的 Viewport 全局做窗口换算，本组件只读。
    property <length> row-pitch: root.row-height + 2px;
    property <int> overscan: 8;
    // 视口顶在内容系的 y（scroll-offset 恒 ≤ 0）
    property <length> visible-top: -Viewport.y;
    // 表顶在内容系的 y：absolute-position 是窗口系且含滚动偏移（活依赖），
    // 减 origin-y 与 Viewport.y 恰好抵消滚动位移——结果为恒定内容坐标，
    // 逐帧自动重算
    property <length> table-top: self.absolute-position.y - Viewport.origin-y - Viewport.y;
    // 可见窗首行绝对索引与行数。view-h <= 0（TestingBackend/无头环境未绑定
    // Viewport）时全量渲染，退化为旧的常驻实例化行为。依赖链单向：窗口量
    // 只依赖 Viewport 与模型长度；下方行容器高度只依赖模型长度——绝不反向
    // 掺入窗口变量，否则与 Viewport.y 绑定成环。
    property <int> window-start: Viewport.view-h <= 0px ? 0
        : clamp(
            Math.floor((visible-top - table-top) / row-pitch) - overscan,
            0,
            max(tracks.length - 1, 0),
        );
    property <int> window-count: Viewport.view-h <= 0px ? tracks.length
        : min(
            tracks.length - window-start,
            Math.ceil(Viewport.view-h / row-pitch) + 2 * overscan,
        );

    // Vue 网格一次定列（2.5rem | 1.4fr | 0.8fr | 4rem，gap 16px，行内距 12px）：
    // Slint 每行是独立布局，stretch 会按各行内容首选宽漂移，必须按根宽算定宽。
    // 收起的列连带少一个 gap，按实际可见列数算（与下方列定义同一开关），
    // 死减满配 gap 会把标题列挤窄出死区
    property <length> grid-available: self.width - 24px - 40px
        - (root.show-duration ? 64px : 0px)
        - Theme.space-4 * (1 + (root.show-album ? 1 : 0) + (root.show-duration ? 1 : 0));
    property <length> title-w: root.show-album ? grid-available * 1.4 / 2.2 : grid-available;
    property <length> album-w: grid-available * 0.8 / 2.2;

    function format-duration(ms: int) -> string {
        if (ms <= 0) {
            return "0:00";
        }
        // 对齐 TS 版 Math.round(ms/1000) 秒
        return Math.mod(Math.round(ms / 1000), 60) < 10
            ? "\{Math.floor(Math.round(ms / 1000) / 60)}:0\{Math.mod(Math.round(ms / 1000), 60)}"
            : "\{Math.floor(Math.round(ms / 1000) / 60)}:\{Math.mod(Math.round(ms / 1000), 60)}";
    }

    // —— 键盘光标（roving）———
    /** 光标行绝对下标；-1 = 尚未进入（首次 ↑/↓/←/→ 或获得焦点时落到首个可见行） */
    in-out property <int> cursor: -1;
    /** 行内子光标：0=行本身 1=歌手链接 2=专辑链接（按该行实际可用的链接数钳制） */
    in-out property <int> cursor-col: 0;
    /** 当前有效光标行（模型缩短后钳住；空表/无光标 = -1） */
    out property <int> cursor-row: tracks.length == 0 || cursor < 0 ? -1 : min(cursor, tracks.length - 1);

    /** 该行可停靠的单元格数：行本身 +（有参数的）歌手链接 + 专辑链接 */
    function cells-of(index: int) -> int {
        if (index < 0 || index >= tracks.length) {
            return 1;
        }
        let r = tracks[index];
        return 1 + (r.artist-mid != "" ? 1 : 0) + (show-album && r.album-mid != "" ? 1 : 0);
    }

    function move-cursor(delta: int) {
        if (tracks.length == 0) {
            return;
        }
        // 首次进入：下移落首个可见行，上移落末行；换行回到行本身
        cursor = cursor < 0
            ? (delta > 0 ? first-visible-row : tracks.length - 1)
            : clamp(cursor + delta, 0, tracks.length - 1);
        cursor-col = 0;
        reveal-row(cursor);
    }

    /** 视口顶部第一个可见行（页面未回写视口高的无头环境退化为首行） */
    property <int> first-visible-row: Viewport.view-h <= 0px ? 0
        : clamp(Math.ceil((-Viewport.y - table-top) / row-pitch), 0, max(tracks.length - 1, 0));

    /** 把第 index 行滚进页面视口（已完整可见则不动）。Flickable 对程序写入的
        越界偏移不钳制，这里算出的 target 必在内容范围内 */
    function reveal-row(index: int) {
        if (Viewport.view-h <= 0px) {
            return;
        }
        let top = table-top + index * row-pitch;
        let bottom = top + row-height;
        let view-top = -Viewport.y;
        let target = top < view-top ? top
            : bottom > view-top + Viewport.view-h ? bottom - Viewport.view-h
            : -1px;
        if (target >= 0px) {
            // 请求通道收的是滚动偏移（≤ 0），target 是内容坐标
            Viewport.scroll-to(-target);
        }
    }

    // 列表级键盘焦点：纯 FocusScope、无 TouchArea，不参与指针命中。按键只投递
    // 给持有焦点的它自己，与行是否是它的子孙无关；未被消费的键照常沿祖先链
    // 冒泡给全局
    list-key := ListKeys {
        width: parent.width;
        height: parent.height;
        available: tracks.length > 0;
        step(delta) => {
            root.move-cursor(delta);
        }
        step-horizontal(dir) => {
            if (root.cursor < 0) {
                root.move-cursor(1);
            }
            cursor-col = clamp(cursor-col + dir, 0, root.cells-of(root.cursor-row) - 1);
        }
        activate => {
            let row = root.cursor-row;
            if (row < 0) {
                return;
            }
            // 子光标格位按该行实际可用的链接排：无歌手链接的行第 1 格就是专辑
            if (root.cursor-col == 1) {
                if (root.tracks[row].artist-mid != "") {
                    Nav.navigate(Route.artist, root.tracks[row].artist-mid);
                } else if (root.show-album && root.tracks[row].album-mid != "") {
                    Nav.navigate(Route.album, root.tracks[row].album-mid);
                } else {
                    Player.play-tracks(root.tracks, row);
                }
            } else if (root.cursor-col == 2 && root.show-album && root.tracks[row].album-mid != "") {
                Nav.navigate(Route.album, root.tracks[row].album-mid);
            } else {
                Player.play-tracks(root.tracks, row);
            }
        }
        focus-gained(reason) => {
            // 进入即有可见光标
            if (root.cursor < 0 && root.tracks.length > 0) {
                root.cursor = root.first-visible-row;
                root.cursor-col = 0;
            }
        }
    }

    VerticalLayout {
        spacing: 2px;

        if show-header && tracks.length > 0: Rectangle {
            height: root.row-height;

            HorizontalLayout {
                padding-left: 12px;
                padding-right: 12px;
                spacing: Theme.space-4;

                Text {
                    width: 40px;
                    text: "#";
                    color: Theme.muted-foreground;
                    font-size: 12.5px;
                    vertical-alignment: center;
                }
                Text {
                    width: root.title-w;
                    text: "标题";
                    color: Theme.muted-foreground;
                    font-size: 12.5px;
                    vertical-alignment: center;
                }
                if root.show-album: Text {
                    width: root.album-w;
                    text: "专辑";
                    color: Theme.muted-foreground;
                    font-size: 12.5px;
                    vertical-alignment: center;
                }
                if root.show-duration: Text {
                    width: 64px;
                    text: "时长";
                    color: Theme.muted-foreground;
                    font-size: 12.5px;
                    horizontal-alignment: right;
                    vertical-alignment: center;
                }
            }
        }

        hg := HoverGroup {
            highlight-color: Theme.neutral-200;
            highlight-opacity: 0.6;
            indicator-icon: Icons.play_arrow;
            indicator-x: 12px;
            indicator-width: 40px;
            indicator-icon-size: 16px;
            indicator-align-start: true;
            // 高度必须显式钉住：hg 是根布局子元素，普通 Rectangle 子元素的
            // 显式 height 不进 preferred 链（repeater 无固有尺寸）→ 布局把
            // hg 压成 0 高 + clip → 整表不可见不可点（截图实测）。旧写法的
            // VerticalLayout 子元素会主动上报 preferred 高度，故无此问题。
            height: tracks.length > 0 ? tracks.length * row-pitch - 2px : 0px;

            // 行窗口容器：固定高只依赖模型长度（N×行距 − 末行后无 spacing），
            // 行按绝对索引绝对定位。宽度必须显式钉住：非布局父级下默认宽由
            // 子 preferred 宽推导，而行 width=parent.width 反向引用容器 →
            // 循环解出 0 宽 → 整表不可命中（drag 回归实测）。整表占位高度
            // 与旧全量实例化一致，Scroll 内容高度/滚动条几何不变；只实例化
            // 可见窗（window-count）行。
            Rectangle {
                x: 0;
                width: parent.width;
                height: tracks.length > 0 ? tracks.length * row-pitch - 2px : 0px;

                // 整数即模型（Slint 无 `0..N` 区间 for）：offset ∈ 0..window-count
                for offset in root.window-count: hover-item := HoverItem {
                    group-id: hg.group-id;
                    x: 0;
                    width: parent.width;
                    height: root.row-height;
                    y: (root.window-start + offset) * root.row-pitch;
                    /** 绝对下标（虚拟化：offset 只是窗内序号，不可作下标用） */
                    property <int> abs-index: root.window-start + offset;
                    // 行数据经命名属性取模型绝对行（loop 变量 offset 只是窗口内
                    // 序号；`row` 名在 for 体内不可作属性名，改 rowd）
                    property <TrackRow> rowd: root.tracks[hover-item.abs-index];
                    /** 行内子光标格位（仅光标行可能非 0）；歌手/专辑链接各占哪一格按本行
                        实际可用的链接排（无歌手链接时专辑占第 1 格） */
                    property <int> cell: root.cursor-row == hover-item.abs-index ? root.cursor-col : 0;
                    property <int> artist-col: rowd.artist-mid != "" ? 1 : -1;
                    property <int> album-col: root.show-album && rowd.album-mid != ""
                        ? (rowd.artist-mid != "" ? 2 : 1) : -1;
                    // 右键菜单关闭后焦点回列表，光标停在触发菜单的行（Esc/
                    // 点外/执行动作同一路径；不还焦点则键盘用户丢失落点）。
                    // is-open 只有弹层真的开过才变化，初始 false 不触发。
                    property <bool> menu-open: row-menu.is-open;
                    changed menu-open => {
                        if (!self.menu-open) {
                            list-key.focus();
                        }
                    }
                    // 键盘光标行高亮：与 hover 滑块同族中性底（仅列表持有键盘焦点时显示，
                    // 鼠标点击不留下「选中」残影）
                    background: list-key.has-focus && root.cursor-row == hover-item.abs-index
                        ? Theme.neutral-200.transparentize(0.45) : transparent;
                    suppress-indicator: Player.queue-current-mid == rowd.mid;
                    clicked => {
                        Player.play-tracks(root.tracks, root.window-start + offset);
                    }
                    // —— 统一右键菜单（全局开关 TrackMenu.enabled 闸）———
                    // 快照带绝对下标（虚拟化：窗口内 offset 不可作下标用）与
                    // 整表模型引用（播放语义零拷贝）；歌单详情页 context 换挡。
                    // 打开坐标走 TrackMenu global（popup 自有属性禁止外层访问）
                    context-enabled: TrackMenu.enabled;
                    context-requested(mx, my) => {
                        TrackMenu.context = Nav.route == Route.playlist
                            ? MenuContext.playlist : MenuContext.library;
                        TrackMenu.index = root.window-start + offset;
                        TrackMenu.track = rowd;
                        // 关闭弹层后的焦点落点 = 被右键的行（同列表 roving 光标）
                        root.cursor = root.window-start + offset;
                        root.cursor-col = 0;
                        TrackMenu.source-list = root.tracks;
                        TrackMenu.open-x = mx;
                        TrackMenu.open-y = my;
                        row-menu.show();
                    }

                    HorizontalLayout {
                        padding-left: 12px;
                        padding-right: 12px;
                        spacing: Theme.space-4;

                        // 序号位：当前行显示跳动条；hover 行让位给 indicator 的播放图标
                        Rectangle {
                            width: 40px;

                            Equalizer {
                                paused: !Player.playing;
                                x: 0;
                                y: (parent.height - self.height) / 2;
                                visible: Player.queue-current-mid == rowd.mid;
                            }
                            Text {
                                text: "\{root.window-start + offset + 1}";
                                color: Theme.muted-foreground;
                                font-size: 13.6px;
                                vertical-alignment: center;
                                x: 0;
                                width: parent.width;
                                visible: Player.queue-current-mid != rowd.mid;
                                opacity: hover-item.hovered ? 0 : 1;
                                animate opacity {
                                    duration: Theme.duration-fast;
                                    easing: cubic-bezier(0.2, 0, 0, 1);
                                }
                            }
                        }

                        // 标题 + 歌手（歌手整体一个链接 → 主歌手页）
                        Rectangle {
                            width: root.title-w;

                            HorizontalLayout {
                                spacing: 6px;
                                alignment: LayoutAlignment.start;

                                title-text := Text {
                                    text: rowd.title;
                                    color: Player.queue-current-mid == rowd.mid ? Theme.track-accent : Theme.foreground;
                                    font-size: 15.2px;
                                    font-weight: Player.queue-current-mid == rowd.mid ? 650 : 400;
                                    vertical-alignment: center;
                                    overflow: elide;
                                }
                                artist-text := Text {
                                    text: rowd.artists;
                                    // hover / 键盘子光标落上时提亮（.text-link 同款）
                                    color: artist-touch.has-hover || hover-item.cell == hover-item.artist-col
                                        ? Theme.foreground : Theme.muted-foreground;
                                    animate color {
                                        duration: Theme.duration-fast;
                                        easing: cubic-bezier(0.2, 0, 0, 1);
                                    }
                                    font-size: 12.8px;
                                    vertical-alignment: center;
                                    overflow: elide;
                                    horizontal-stretch: 1;
                                }
                            }

                            // 歌手名跳转（覆盖在文本上）；无参数（QQ 行远端 mid 缺失/无歌手数据）→
                            // 链接禁用。命中区收在歌手名文本宽内：此前铺到标题列末尾，点歌名右侧的
                            // 空白也会跳歌手页（想播这一行却被带走），且那片空白根本不像链接。
                            // 键盘：不是 Tab 停靠点，由列表的 ←/→ 子光标到达
                            artist-touch := KeyTouch {
                                x: title-text.width + 6px;
                                width: max(0px, min(parent.width - self.x, artist-text.preferred-width));
                                height: parent.height;
                                tab-stop: false;
                                ring-forced: hover-item.cell == hover-item.artist-col;
                                ring-radius: Theme.radius-sm;
                                enabled: rowd.artist-mid != "";
                                mouse-cursor: rowd.artist-mid != "" ? pointer : default;
                                activate-on-click: true;
                                activated => {
                                    Nav.navigate(Route.artist, rowd.artist-mid);
                                }
                                // 启用的 TouchArea 对所有按键 grab（会吞右键）：
                                // 右键释放转发给行宿主打开菜单，坐标经窗口系
                                // absolute-position 差值换算回行内
                                pointer-event(event) => {
                                    if (event.kind == PointerEventKind.up
                                        && event.button == PointerEventButton.right) {
                                        hover-item.context-requested(
                                            self.absolute-position.x - hover-item.absolute-position.x + self.mouse-x,
                                            self.absolute-position.y - hover-item.absolute-position.y + self.mouse-y,
                                        );
                                    }
                                }
                            }
                        }

                        // 专辑（可点跳专辑页；窄窗由 show-album 收起；
                        // 无参数 → 退化纯文本，不渲染死链接）
                        if root.show-album && rowd.album-mid != "": TextLink {
                            width: root.album-w;
                            // 键盘：不是 Tab 停靠点，由列表的 ←/→ 子光标到达
                            tab-stop: false;
                            ring-forced: hover-item.cell == hover-item.album-col;
                            // 撑满行高：TextLink 组件内固定高 20px 会被行布局
                            // 顶对齐（交叉轴默认顶对齐），专辑文字随之上浮。
                            // 不能写 parent.height（布局子元素引用父高成环）
                            height: root.row-height;
                            text: rowd.album;
                            font-size: 13.4px;
                            context-enabled: true;
                            clicked => {
                                Nav.navigate(Route.album, rowd.album-mid);
                            }
                            // 行内链接右键转发（坐标换算同上：absolute 差值 + 链接内偏移）
                            context-requested(lx, ly) => {
                                hover-item.context-requested(
                                    self.absolute-position.x - hover-item.absolute-position.x + lx,
                                    self.absolute-position.y - hover-item.absolute-position.y + ly,
                                );
                            }
                        }
                        if root.show-album && rowd.album-mid == "": Text {
                            width: root.album-w;
                            text: rowd.album;
                            color: Theme.muted-foreground;
                            font-size: 13.4px;
                            vertical-alignment: center;
                            overflow: elide;
                        }

                        // 时长列与表头同一开关：数据源无时长（如 smartbox 搜索）整列收起，
                        // 不再渲染右缘 64px 的 "—"；条件元素在布局里须显式几何
                        if root.show-duration: Text {
                            width: 64px;
                            height: root.row-height;
                            text: root.format-duration(rowd.duration-ms);
                            color: Theme.muted-foreground;
                            font-size: 13.4px;
                            horizontal-alignment: right;
                            vertical-alignment: center;
                        }
                    }

                    // 行锚定菜单弹层：编译期 PopupWindow 从元素树摘除（不参与
                    // 布局/hover），坐标相对本行、show 时钳制进窗口、滚动跟随锚、
                    // 行卸载自动关。close-policy 必须显式 close-on-click-outside：
                    // slint 默认 close-on-click 连弹层内完整点击也一并关闭，
                    // 「加入播放列表…」后的二级 picker 面板不可达（S6 缺陷 #1）；
                    // 点外 press / ESC / 业务 dismissed→close() 三路关闭在
                    // close-on-click-outside 下均不受影响。
                    // 内容面板读 TrackMenu 全局快照——每行一个实例，仅 show 的生效
                    row-menu := PopupWindow {
                        close-policy: close-on-click-outside;
                        x: TrackMenu.open-x;
                        y: TrackMenu.open-y + 4px;
                        width: 216px;
                        height: menu-panel.height;

                        menu-panel := TrackMenuPanel {
                            dismissed => {
                                row-menu.close();
                            }
                        }
                    }
                }
            }
        }

        if tracks.length == 0: Text {
            height: 64px;
            text: "这里还没有歌曲";
            color: Theme.muted-foreground;
            horizontal-alignment: center;
            vertical-alignment: center;
        }
    }
}
