// 歌单详情（PlaylistView.vue）：封面 + 页头（返回/标题/元信息/播放全部）+ 通栏曲目表。
// 本地投影：创建者/标签/简介/播放数无数据源（媒体库无此域），头部只呈 N 首 + 总时长。
import { Theme } from "theme.slint";
import { Icons } from "icons.slint";
import { Button, ButtonVariant } from "primitives.slint";
import { PageHeader } from "page-parts.slint";
import { TrackTable } from "track-table.slint";
import { Nav } from "nav.slint";
import { Data, Player } from "stores.slint";

export component PlaylistPage inherits Rectangle {
    background: transparent;

    VerticalLayout {
        padding-top: Theme.space-6;
        padding-left: Theme.space-8;
        padding-right: Theme.space-8;
        padding-bottom: Theme.space-10;
        spacing: Theme.space-4;

        if !Data.playlist-found: Text {
            text: "未找到歌单（可能已删除）";
            color: Theme.muted-foreground;
            font-size: 14px;
            horizontal-alignment: center;
        }

        if Data.playlist-found: Rectangle {
            // 两段式头部（Vue .playlist-head）：封面 | 页头信息，垂直居中。
            // 子元素勿引用 parent.width（布局首选宽计算成环，会解出负宽）。
            width: parent.width;
            height: 176px;

            HorizontalLayout {
                spacing: Theme.space-8;
                cross-axis-alignment: center;

                Rectangle {
                    width: 176px;
                    height: 176px;
                    border-radius: Theme.radius-lg;
                    clip: true;
                    background: Theme.muted;
                    drop-shadow-blur: 2px;
                    drop-shadow-color: #241F1B.transparentize(0.92);
                    drop-shadow-offset-y: 1px;

                    Image {
                        x: 0;
                        y: 0;
                        width: parent.width;
                        height: parent.height;
                        source: Data.playlist-cover;
                        image-fit: ImageFit.cover;
                    }
                }

                // 信息列：页头在上、播放全部在下（Vue .playlist-actions 位置）
                VerticalLayout {
                    horizontal-stretch: 1;
                    alignment: LayoutAlignment.center;
                    spacing: Theme.space-3;

                    PageHeader {
                        title: Data.playlist-name;
                        show-back: true;
                        meta-items: Data.playlist-meta-items;

                        back => {
                            Nav.back();
                        }
                    }

                    if Data.playlist-tracks.length > 0: HorizontalLayout {
                        // start 取按钮自然宽（单按钮无 stretch 需求，不踩 alignment 坑）
                        alignment: LayoutAlignment.start;

                        Button {
                            variant: ButtonVariant.default;
                            small: true;
                            icon: Icons.play_arrow;
                            icon-size: 17.6px;
                            text: "播放全部";
                            height: 32px;
                            clicked => {
                                Player.play-tracks(Data.playlist-tracks, 0);
                            }
                        }
                    }
                }
            }
        }

        if Data.playlist-found: TrackTable {
            tracks: Data.playlist-tracks;
            show-header: true;
        }
    }
}
