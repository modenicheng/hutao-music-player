// 歌单详情（PlaylistView.vue）：封面 + 页头（返回/标题/元信息/播放全部）+ 通栏曲目表。
// 状态机渲染（M3）：0=初始 1=加载中 2=就绪 3=未找到 4=失败（离线/网络）。
// 本地投影：创建者/标签/简介/播放数无数据源，头部只呈 N 首 + 总时长；
// 远端（qq: 参数）：创建者/播放数/超窗标注由 remote_details 投影。
import { Theme } from "theme.slint";
import { Icons } from "icons.slint";
import { Button, ButtonVariant } from "primitives.slint";
import { PageHeader } from "page-parts.slint";
import { TrackTable } from "track-table.slint";
import { Nav } from "nav.slint";
import { Data, Player } from "stores.slint";

export component PlaylistPage inherits Rectangle {
    background: transparent;

    VerticalLayout {
        padding-top: Theme.space-6;
        padding-left: Theme.space-8;
        padding-right: Theme.space-8;
        padding-bottom: Theme.space-10;
        spacing: Theme.space-4;

        if Data.playlist-state == 1: Text {
            height: 64px;
            text: "正在加载…";
            color: Theme.muted-foreground;
            font-size: 13.5px;
            horizontal-alignment: center;
            vertical-alignment: center;
        }

        if Data.playlist-state == 3: Text {
            height: 64px;
            text: "未找到歌单（可能已删除）";
            color: Theme.muted-foreground;
            font-size: 13.5px;
            horizontal-alignment: center;
            vertical-alignment: center;
        }

        if Data.playlist-state == 4: Text {
            height: 64px;
            text: "加载失败：无法连接守护进程或网络不可用";
            color: Theme.muted-foreground;
            font-size: 13.5px;
            horizontal-alignment: center;
            vertical-alignment: center;
        }

        if Data.playlist-state == 2: Rectangle {
            // 两段式头部（Vue .playlist-head）：封面 | 页头信息，垂直居中。
            // 子元素勿引用 parent.width（布局首选宽计算成环，会解出负宽）。
            width: parent.width;
            height: 176px;

            HorizontalLayout {
                spacing: Theme.space-8;
                cross-axis-alignment: center;

                Rectangle {
                    width: 176px;
                    height: 176px;
                    border-radius: Theme.radius-lg;
                    clip: true;
                    background: Theme.muted;
                    drop-shadow-blur: 2px;
                    drop-shadow-color: #241F1B.transparentize(0.92);
                    drop-shadow-offset-y: 1px;

                    Image {
                        x: 0;
                        y: 0;
                        width: parent.width;
                        height: parent.height;
                        source: Data.playlist-cover;
                        image-fit: ImageFit.cover;
                    }
                }

                // 信息列：页头即承载播放全部（页面级主动作放页头动作区，
                // 原 .playlist-actions 独立行已收编）
                PageHeader {
                    horizontal-stretch: 1;
                    title: Data.playlist-name;
                    show-back: true;
                    meta-items: Data.playlist-meta-items;

                    back => {
                        Nav.back();
                    }

                    if Data.playlist-tracks.length > 0: Button {
                        variant: ButtonVariant.default;
                        small: true;
                        icon: Icons.play_arrow;
                        icon-size: 17.6px;
                        text: "播放全部";
                        height: 32px;
                        clicked => {
                            Player.play-tracks(Data.playlist-tracks, 0);
                        }
                    }
                }
            }
        }

        if Data.playlist-state == 2: TrackTable {
            tracks: Data.playlist-tracks;
            show-header: true;
        }
    }
}
