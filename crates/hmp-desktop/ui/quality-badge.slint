// 音质徽章（QualityBadge.vue，DESIGN.md v0.2 增补）：
// 显示实际生效档位 = min(用户偏好 Quality.selected, 曲目最高 Player.track-max-tier)；
// 点击弹出四档选择（PopupWindow，向上展开），超出曲目提供的档位禁用。
import { Theme } from "theme.slint";
import { AppIcon } from "primitives.slint";
import { Icons } from "icons.slint";
import { Player, Quality } from "stores.slint";

export component QualityBadge inherits Rectangle {
    width: badge-text.preferred-width + 16px;
    height: 22px;
    border-radius: Theme.radius-full;
    background: touch.has-hover ? Theme.muted : Theme.track-accent-soft;
    animate background {
        duration: Theme.duration-fast;
    }

    touch := TouchArea {
        mouse-cursor: pointer;
        clicked => {
            quality-pop.show();
        }
    }

    badge-text := Text {
        text: Quality.tier-label(Quality.effective(Player.track-max-tier));
        color: touch.has-hover ? Theme.foreground : Theme.track-accent;
        font-size: 11.5px;
        font-weight: 600;
        horizontal-alignment: center;
        vertical-alignment: center;
        width: parent.width;
        height: parent.height;
        animate color {
            duration: Theme.duration-fast;
        }
    }

    quality-pop := PopupWindow {
        x: (parent.width - self.width) / 2;
        y: -self.height - 10px;
        width: 208px;
        height: 244px;

        Rectangle {
            border-radius: Theme.radius-lg;
            background: Theme.surface-3;
            drop-shadow-blur: 12px;
            drop-shadow-color: #241F1B.transparentize(0.82);
            drop-shadow-offset-y: 4px;

            VerticalLayout {
                padding: 8px;
                spacing: 2px;

                Text {
                    height: 26px;
                    text: "选择音质";
                    color: Theme.muted-foreground;
                    font-size: 12px;
                    vertical-alignment: center;
                }

                for tier in [0, 1, 2, 3]: Rectangle {
                    height: 44px;
                    border-radius: Theme.radius-md;
                    background: option-touch.has-hover && tier <= Player.track-max-tier ? Theme.track-accent-soft : transparent;
                    animate background {
                        duration: Theme.duration-fast;
                    }

                    option-touch := TouchArea {
                        enabled: tier <= Player.track-max-tier;
                        mouse-cursor: pointer;
                        clicked => {
                            Quality.select(tier);
                            quality-pop.close();
                        }
                    }

                    HorizontalLayout {
                        padding-left: 8px;
                        padding-right: 8px;
                        spacing: 8px;

                        VerticalLayout {
                            alignment: LayoutAlignment.center;
                            spacing: 1px;

                            Text {
                                text: Quality.tier-label(tier);
                                color: tier == Quality.selected ? Theme.track-accent : Theme.foreground;
                                font-size: 13.6px;
                                font-weight: tier == Quality.selected ? 650 : 400;
                            }
                            Text {
                                text: tier > Player.track-max-tier ? "本曲未提供" : Quality.tier-detail(tier);
                                color: Theme.muted-foreground;
                                font-size: 11.5px;
                            }
                        }

                        Rectangle {
                            horizontal-stretch: 1;
                        }

                        if tier == Quality.selected: AppIcon {
                            source: Icons.check;
                            icon-color: Theme.track-accent;
                            width: 15px;
                            height: 15px;
                            y: (parent.height - self.height) / 2;
                        }
                    }

                    opacity: tier <= Player.track-max-tier ? 1 : 0.45;
                }
            }
        }
    }
}
