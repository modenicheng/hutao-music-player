// 播放列表抽屉（QueueDrawer.vue，DESIGN.md v0.7/v0.8）：
// - 主界面态：全屏遮罩压暗（点击关闭）+ 右上浮板（radius-lg 全圆角 + 全边框），
//   底边停在 PlayerBar 上方（layout-gap×2 + player-bar-height）。
// - themed 态（播放页 overlay 打开中，M6）：抽屉属于播放页上下文，整只
//   跟随专辑色——贴 overlay 右缘通高、底边停在底部控制台上方
//   （np-console-clearance），右侧直角；hover 底与当前行高亮用
//   TrackPalette（ctx-* / accent-soft），暗色下底为 track-deep→surface-1
//   渐变、面板前景换 deep-fg（对齐 Vue .queue-drawer.themed）。
import { Theme } from "theme.slint";
import { Icons } from "icons.slint";
import { AppIcon, Button, Equalizer, HoverGroup, HoverItem, Scroll } from "primitives.slint";
import { Player, TrackPalette } from "stores.slint";

export component QueueDrawer inherits Rectangle {
    background: transparent;
    clip: false;

    /** themed = overlay 打开中：抽屉跟随播放页上下文 */
    property <bool> themed: Player.overlay-visible;
    /** themed 暗色下的面板前景（Vue .queue-drawer.themed 的 color 覆写） */
    property <color> panel-fg: themed && Theme.dark ? TrackPalette.deep-fg : Theme.foreground;

    // 面板软卸载：隐藏后保持挂载一个动画周期（淡出播完），随后 visible=false。
    // opacity 0 不参与命中剔除——面板若常驻挂载，其内部 TouchArea/滚动条会
    // 在隐藏时拦走内容区右缘 ~380px 的点击与拖拽（滚动条 thumb 恰好被盖住，
    // 表现为"无法拖动"）；visible=false 才真正退出命中测试。
    property <bool> qv <=> Player.queue-visible;
    property <bool> fade-hold: false;
    property <bool> panel-mounted: qv || fade-hold;
    changed qv => {
        if (self.qv) {
            self.fade-hold = false;
        } else {
            self.fade-hold = true;
            unmount-timer.restart();
        }
    }
    unmount-timer := Timer {
        interval: Theme.duration-normal + 50ms;
        running: false;
        triggered => {
            root.fade-hold = false;
        }
    }

    function format-duration(ms: int) -> string {
        if (ms <= 0) {
            return "0:00";
        }
        // 对齐 TS 版 Math.round(ms/1000) 秒
        return Math.mod(Math.round(ms / 1000), 60) < 10
            ? "\{Math.floor(Math.round(ms / 1000) / 60)}:0\{Math.mod(Math.round(ms / 1000), 60)}"
            : "\{Math.floor(Math.round(ms / 1000) / 60)}:\{Math.mod(Math.round(ms / 1000), 60)}";
    }

    // —— 全屏遮罩（dark 下压暗加重 0.2→0.45），常驻挂载以便淡出，仅可见时可点 ——
    Rectangle {
        background: Theme.scrim;
        opacity: Player.queue-visible ? 1 : 0;
        animate opacity {
            duration: Theme.duration-normal;
            easing: cubic-bezier(0.2, 0, 0, 1);
        }

        scrim-touch := TouchArea {
            enabled: Player.queue-visible;
            clicked => {
                Player.hide-queue();
            }
        }
    }

    // —— 浮板：主界面=右上圆角卡；themed=贴右缘通高、停在控制台上方 ——
    // 挂载层覆盖全窗（含标题栏带）：窗口锚定整体 +title-bar-height 补偿，
    // 面板顶/底边与顶栏以下挂载时逐像素一致（遮罩多盖顶部 32px）
    panel := Rectangle {
        visible: root.panel-mounted;
        x: root.themed ? parent.width - self.width
            : parent.width - self.width - Theme.layout-gap;
        y: root.themed ? Theme.title-bar-height
            : Theme.title-bar-height + Theme.layout-gap;
        width: min(380px, parent.width - Theme.layout-gap * 2);
        height: root.themed
            ? parent.height - Theme.title-bar-height - Theme.np-console-clearance
            : parent.height - Theme.title-bar-height - Theme.layout-gap * 3 - Theme.player-bar-height;
        border-top-left-radius: Theme.radius-lg;
        border-bottom-left-radius: Theme.radius-lg;
        border-top-right-radius: root.themed ? 0px : Theme.radius-lg;
        border-bottom-right-radius: root.themed ? 0px : Theme.radius-lg;
        // 非 themed 底：Vue 渐变（亮=surface-3→surface-2 60%，暗=surface-2→surface-1 70%）；
        // themed 态整面被下方专辑色渐变层盖住，保持原平涂即可
        background: root.themed ? Theme.surface-2
            : Theme.dark
                ? @linear-gradient(180deg, Theme.surface-2, Theme.surface-1 0.7)
                : @linear-gradient(180deg, Theme.surface-3, Theme.surface-2 0.6);
        border-width: 1px;
        border-color: Theme.border;
        drop-shadow-blur: 32px;
        drop-shadow-color: #241F1B.transparentize(0.78);
        drop-shadow-offset-y: 8px;
        animate x {
            duration: Theme.duration-normal;
            easing: cubic-bezier(0.2, 0, 0, 1);
        }
        animate y {
            duration: Theme.duration-normal;
            easing: cubic-bezier(0.2, 0, 0, 1);
        }
        animate height {
            duration: Theme.duration-normal;
            easing: cubic-bezier(0.2, 0, 0, 1);
        }

        // themed 态底：整只跟随专辑色（亮=accent-soft→surface-2 60%，
        // 暗=deep→surface-1 70%）；叠在面板中性底之上、内容之下。
        // 圆角与面板同步（themed 右侧直角），否则方角底盖掉面板圆角
        if root.themed: Rectangle {
            border-top-left-radius: Theme.radius-lg;
            border-bottom-left-radius: Theme.radius-lg;
            border-top-right-radius: 0px;
            border-bottom-right-radius: 0px;
            background: Theme.dark
                ? @linear-gradient(180deg, TrackPalette.deep, Theme.surface-1 0.7)
                : @linear-gradient(180deg, TrackPalette.accent-soft, Theme.surface-2 0.6);
        }

        opacity: Player.queue-visible ? 1 : 0;
        animate opacity {
            duration: Theme.duration-normal;
            easing: cubic-bezier(0.2, 0, 0, 1);
        }
        // 隐藏态延迟一个动画周期后 visible=false 软卸载（见组件头部说明）：
        // opacity 0 不参与命中剔除，常驻挂载时面板内部的 TouchArea/滚动条
        // 会拦走内容区右缘 ~380px 的点击与拖拽——滚动条 thumb 恰好被盖住

        VerticalLayout {
            // Vue 面板自带内距：头部上方留白
            padding-top: 12px;

            // —— 头部：标题 + 元信息 + 清空 + 关闭 ——
            HorizontalLayout {
                height: 56px;
                padding-left: Theme.space-4;
                padding-right: Theme.space-3;
                spacing: Theme.space-2;

                Rectangle {
                    horizontal-stretch: 1;

                    VerticalLayout {
                        alignment: LayoutAlignment.center;
                        spacing: 1px;

                        Text {
                            text: "播放列表";
                            color: root.panel-fg;
                            font-size: 15.2px;
                            font-weight: 650;
                        }
                        Text {
                            text: Player.queue-meta;
                            color: Theme.muted-foreground;
                            font-size: 12px;
                            visible: Player.queue.length > 0;
                        }
                    }
                }

                Button {
                    text: "清空";
                    small: true;
                    tool-tip: "清空播放列表";
                    visible: Player.queue.length > 0;
                    height: 32px;
                    clicked => {
                        Player.clear-queue();
                    }
                }
                Button {
                    icon: Icons.close;
                    icon-only: true;
                    icon-size: 18px;
                    tool-tip: "关闭";
                    width: 32px;
                    height: 32px;
                    clicked => {
                        Player.hide-queue();
                    }
                }
            }

            Rectangle {
                height: 1px;
                background: Theme.hairline;
            }

            // —— 行列表 ——
            Scroll {
                vertical-stretch: 1;

                // Vue --queue-hover: var(--muted) @ opacity 1；行 radius-md 复制到滑块
                hg := HoverGroup {
                    highlight-color: root.themed ? TrackPalette.accent-soft : Theme.muted;
                    highlight-opacity: 1.0;
                    item-radius: Theme.radius-md;

                    VerticalLayout {
                        padding-bottom: Theme.space-6;

                        for row[index] in Player.queue: drawer-item := HoverItem {
                            group-id: hg.group-id;
                            height: 49px;
                            suppress-indicator: Player.queue-current-mid == row.mid;
                            clicked => {
                                Player.play-at(index);
                            }

                            HorizontalLayout {
                                padding-left: Theme.space-4;
                                padding-right: 17px;
                                spacing: Theme.space-3;

                                // 序号 / 跳动条（1.6rem）
                                Rectangle {
                                    width: 25.6px;

                                    Equalizer {
                                        paused: !Player.playing;
                                        bar-color: TrackPalette.ctx-accent;
                                        x: 0;
                                        y: (parent.height - self.height) / 2;
                                        visible: Player.queue-current-mid == row.mid;
                                    }
                                    Text {
                                        text: "\{index + 1}";
                                        color: Theme.muted-foreground;
                                        font-size: 13px;
                                        vertical-alignment: center;
                                        visible: Player.queue-current-mid != row.mid;
                                    }
                                }

                                // 封面缩略（2.25rem，radius-sm）
                                Rectangle {
                                    width: 36px;
                                    height: 36px;
                                    border-radius: Theme.radius-sm;
                                    clip: true;
                                    background: Theme.muted;

                                    Image {
                                        x: 0;
                                        y: 0;
                                        width: parent.width;
                                        height: parent.height;
                                        source: row.cover;
                                        image-fit: ImageFit.cover;
                                    }
                                }

                                VerticalLayout {
                                    horizontal-stretch: 1;
                                    alignment: LayoutAlignment.center;
                                    spacing: 1px;

                                    Text {
                                        text: row.title;
                                        color: Player.queue-current-mid == row.mid ? TrackPalette.ctx-accent : root.panel-fg;
                                        font-size: 14.4px;
                                        font-weight: Player.queue-current-mid == row.mid ? 650 : 400;
                                        overflow: elide;
                                    }
                                    Text {
                                        text: row.artists;
                                        color: Theme.muted-foreground;
                                        font-size: 12px;
                                        overflow: elide;
                                    }
                                }

                                Text {
                                    width: 44px;
                                    text: format-duration(row.duration-ms);
                                    color: Theme.muted-foreground;
                                    font-size: 13px;
                                    horizontal-alignment: right;
                                    vertical-alignment: center;
                                    // hover 交叉淡出（opacity 渐隐，非 visible 瞬切）
                                    opacity: drawer-item.hovered ? 0 : 1;
                                    animate opacity {
                                        duration: Theme.duration-fast;
                                        easing: cubic-bezier(0.2, 0, 0, 1);
                                    }
                                }

                                // 移除：hover 行时时长淡出、原位浮现（网易云式行尾交互）
                                Rectangle {
                                    width: 28px;
                                    height: 28px;
                                    y: (parent.height - self.height) / 2;
                                    border-radius: Theme.pill(self.height);
                                    background: remove-touch.has-hover ? Theme.neutral-200 : transparent;
                                    opacity: drawer-item.hovered ? 1 : 0;
                                    animate opacity {
                                        duration: Theme.duration-fast;
                                        easing: cubic-bezier(0.2, 0, 0, 1);
                                    }

                                    remove-touch := TouchArea {
                                        mouse-cursor: pointer;
                                        clicked => {
                                            Player.remove-at(index);
                                        }
                                    }
                                    AppIcon {
                                        source: Icons.close;
                                        icon-color: Theme.muted-foreground;
                                        width: 15px;
                                        height: 15px;
                                        x: (parent.width - self.width) / 2;
                                        y: (parent.height - self.height) / 2;
                                    }
                                }
                            }
                        }

                        // —— 空态（主/副文案居中成组，间距对齐 Vue .drawer-empty）———
                        if Player.queue.length == 0: Rectangle {
                            height: 160px;

                            VerticalLayout {
                                x: 0;
                                y: 0;
                                width: parent.width;
                                height: parent.height;
                                alignment: LayoutAlignment.center;
                                spacing: Theme.space-1;

                                Text {
                                    text: "播放列表是空的";
                                    color: Theme.muted-foreground;
                                    font-size: 14px;
                                    horizontal-alignment: center;
                                }
                                Text {
                                    text: "从发现、搜索或歌单里挑几首吧";
                                    color: Theme.muted-foreground;
                                    font-size: 12px;
                                    horizontal-alignment: center;
                                }
                            }
                        }
                    }
                }
            }
        }
    }
}
