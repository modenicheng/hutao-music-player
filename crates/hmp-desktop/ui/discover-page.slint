// 发现页（M4 在线内容页）：推荐歌单广场 + 新歌速递——daemon
// DiscoverGet IPC（免登录；AUDIT §8.2 内容读服务同源）。
// 布局遵循上游内容自撑约定：Scroll 的 content VerticalLayout 会给子项
// preferred-height，页面禁止绑定 parent.height（会塌缩为 0）。
import { Theme } from "theme.slint";
import { Button, ButtonVariant } from "primitives.slint";
import { PageHeader, SectionHeader, CoverCardGrid } from "page-parts.slint";
import { TrackTable } from "track-table.slint";
import { Nav, Route } from "nav.slint";
import { Data, Player } from "stores.slint";

export component DiscoverPage inherits Rectangle {
    background: transparent;

    VerticalLayout {
        padding-top: Theme.space-6;
        padding-left: Theme.space-8;
        padding-right: Theme.space-8;
        padding-bottom: Theme.space-10;
        spacing: Theme.space-6;

        PageHeader {
            title: "发现";
            meta-items: Data.discover-playlists.length > 0
                ? [Data.discover-playlists.length + " 个歌单"] : [];

            // 页面级主动作放页头动作区：加载中显示提示，其余态显示刷新
            if Data.discover-state == 1: Text {
                text: "正在加载…";
                color: Theme.muted-foreground;
                font-size: 13px;
            }
            if Data.discover-state != 1: Button {
                text: "刷新";
                variant: ButtonVariant.outline;
                clicked => {
                    Data.refresh-discover();
                }
            }
        }

        // 状态机：0=初始 1=加载中 2=有内容 3=空 4=失败
        if Data.discover-state == 0 || Data.discover-state == 1: Rectangle {
            height: 200px;

            Text {
                y: 80px;
                width: parent.width;
                text: "正在加载…";
                color: Theme.muted-foreground;
                font-size: 14px;
                horizontal-alignment: center;
            }
        }

        if Data.discover-state == 3 || Data.discover-state == 4: Rectangle {
            height: 200px;

            VerticalLayout {
                alignment: center;

                Text {
                    text: Data.discover-state == 4 ? "加载失败" : "暂无内容";
                    color: Theme.foreground;
                    font-size: 15px;
                    horizontal-alignment: center;
                }
                Text {
                    text: Data.discover-state == 4 ? "离线或网络异常，点击右上角刷新重试" : "";
                    color: Theme.muted-foreground;
                    font-size: 13px;
                    horizontal-alignment: center;
                }
            }
        }

        // —— 推荐歌单（响应式网格，同库页歌单网格写法）——
        if Data.discover-state == 2 && Data.discover-playlists.length > 0: VerticalLayout {
            spacing: Theme.space-4;

            SectionHeader {
                title: "推荐歌单";
            }

            // CoverCardGrid 按容器宽换行（HorizontalLayout 单行会溢出裁掉）
            CoverCardGrid {
                width: parent.width;
                cards: Data.discover-playlists;
                row-count: Data.discover-playlists.length;
                card-clicked(mid) => {
                    Nav.navigate(Route.playlist, mid);
                }
            }
        }

        // —— 新歌速递（曲目表；点击行即播）——
        if Data.discover-state == 2 && Data.discover-new-songs.length > 0: VerticalLayout {
            spacing: Theme.space-4;

            SectionHeader {
                title: "新歌速递";
                more-to: "播放全部";
                more-clicked => {
                    Player.play-tracks(Data.discover-new-songs, 0);
                }
            }

            TrackTable {
                tracks: Data.discover-new-songs;
                show-duration: true;
            }
        }
    }
}
