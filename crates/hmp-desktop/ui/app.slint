// 应用壳（MainLayout.vue + PlayerOverlay/QueueDrawer 挂载点）：
// surface-1 底 + layout-gap 内距网格——侧栏（跨两行）/ 内容浮板 / 播放条；
// 侧栏宽度过渡（slow S 曲线），≤52rem 自动收图标栏（手动切换优先）。
import { Theme } from "theme.slint";
import { Scroll, HoverBus, EqClock, EqClockHost } from "primitives.slint";
import { Sidebar } from "sidebar.slint";
import { PlayerBar } from "player-bar.slint";
import { QueueDrawer } from "queue-drawer.slint";
import { NowPlayingOverlay } from "now-playing.slint";
import { LibraryPage } from "library-page.slint";
import { RecentPage } from "recent-page.slint";
import { MusicLibraryPage } from "music-library-page.slint";
import { DownloadsPage } from "downloads-page.slint";
import { PurchasedPage } from "purchased-page.slint";
import { PlaylistPage } from "playlist-page.slint";
import { AlbumPage } from "album-page.slint";
import { ArtistPage } from "artist-page.slint";
import { SettingsPage } from "settings-page.slint";
import { SettingsGeneralPage } from "settings-general-page.slint";
import { SettingsPlaybackPage } from "settings-playback-page.slint";
import { SettingsAccountPage } from "settings-account-page.slint";
import { SearchPage } from "search-page.slint";
import { Nav, Route } from "nav.slint";
import { Player, Data, Quality, NowPlaying } from "stores.slint";
import { Theme } from "theme.slint";
import { TrackRow, CoverCardData, FolderRow, LyricRow, CommentRow } from "data.slint";

// 供生成代码（Rust 侧）访问的 global 与数据结构（HoverBus/EqClock 供集成测试探针）
export { Theme, Nav, Player, Quality, Data, NowPlaying, Route, TrackRow, CoverCardData, FolderRow, LyricRow, CommentRow, HoverBus, EqClock }

export component AppWindow inherits Window {
    title: "胡桃音乐";
    preferred-width: 1280px;
    preferred-height: 800px;
    min-width: 683px;
    min-height: 576px;
    // 无边框：niri/winit 的 CSD 标题栏缺 CJK 字体（显示方框），平铺下也不需要
    no-frame: true;

    // Equalizer 共享时钟驱动（0×0 不可见，见 primitives.slint）
    EqClockHost { }
    background: Theme.surface-1;
    forward-focus: esc-scope;

    in-out property <length> win-width <=> Theme.win-width;
    init => {
        Theme.win-width = self.width;
    }
    changed width => {
        Theme.win-width = self.width;
    }

    // —— 侧栏收起状态机（MainLayout.vue：手动切换优先，跨断点回自动）———
    property <int> manual-collapsed: -1; // -1=自动 0=展开 1=收起
    property <bool> narrow: Theme.win-width <= 832px;
    property <bool> sidebar-collapsed: manual-collapsed == -1 ? narrow : manual-collapsed == 1;
    changed narrow => {
        manual-collapsed = -1;
    }

    property <length> pad: Theme.layout-gap;
    property <length> sidebar-w: sidebar-collapsed ? 64px : Theme.sidebar-width;
    animate sidebar-w {
        duration: Theme.duration-slow;
        easing: cubic-bezier(0.2, 0, 0, 1);
    }

    // —— 侧栏（跨两行）———
    Sidebar {
        x: pad;
        y: pad;
        width: sidebar-w;
        height: parent.height - pad * 2;
        collapsed: sidebar-collapsed;
        toggle-collapsed => {
            manual-collapsed = sidebar-collapsed ? 0 : 1;
        }
    }

    // —— 内容浮板（滚动交给内部 Scroll）———
    content := Rectangle {
        x: pad + sidebar-w + pad;
        y: pad;
        width: parent.width - self.x - pad;
        height: parent.height - pad * 2 - Theme.player-bar-height - pad;
        border-radius: Theme.radius-lg;
        clip: true;
        background: Theme.surface-2;

        Scroll {
            x: 0;
            y: 0;
            width: parent.width;
            height: parent.height;

            if Nav.route == Route.library: LibraryPage {
                width: parent.width;
            }

            if Nav.route == Route.recent: RecentPage {
                width: parent.width;
            }

            if Nav.route == Route.local: MusicLibraryPage {
                width: parent.width;
            }

            if Nav.route == Route.downloads: DownloadsPage {
                width: parent.width;
            }

            if Nav.route == Route.purchased: PurchasedPage {
                width: parent.width;
            }

            if Nav.route == Route.playlist: PlaylistPage {
                width: parent.width;
            }

            if Nav.route == Route.album: AlbumPage {
                width: parent.width;
            }

            if Nav.route == Route.artist: ArtistPage {
                width: parent.width;
            }

            if Nav.route == Route.settings: SettingsPage {
                width: parent.width;
            }

            if Nav.route == Route.settings-general: SettingsGeneralPage {
                width: parent.width;
            }

            if Nav.route == Route.settings-playback: SettingsPlaybackPage {
                width: parent.width;
            }

            if Nav.route == Route.settings-account: SettingsAccountPage {
                width: parent.width;
            }

            if Nav.route == Route.search: SearchPage {
                width: parent.width;
            }

            // 未移植模块（M4 在线内容页）：诚实占位——推荐/榜单内容读接口
            // 尚未排期（搜索已接 daemon Search IPC，docs/AUDIT.md §8.2）。
            if Nav.route == Route.home || Nav.route == Route.discover || Nav.route == Route.top
                || Nav.route == Route.top-detail: Rectangle {
                width: parent.width;
                height: 240px;

                Text {
                    y: 96px;
                    width: parent.width;
                    text: "在线内容页依赖 QQ 内容接口（推荐/榜单），后续版本接入";
                    color: Theme.muted-foreground;
                    font-size: 14px;
                    horizontal-alignment: center;
                }
            }
        }
    }

    // —— 播放条 ———
    PlayerBar {
        x: content.x;
        y: content.y + content.height + pad;
        width: content.width;
        height: Theme.player-bar-height;
    }

    // —— 操作反馈条（命令被拒/离线/装载失败；Rust 写入、4s 自动清空）——
    // 深胡桃实底 pill，亮暗两主题同读法；位于内容区底部内缘、播放条上方。
    if Player.feedback != "": Rectangle {
        x: (parent.width - self.width) / 2;
        y: content.y + content.height - self.height - Theme.space-3;
        height: 36px;
        width: min(feedback-text.preferred-width + 40px, parent.width - Theme.space-6 * 2);
        border-radius: Theme.pill(self.height);
        background: Theme.track-deep;
        drop-shadow-blur: 16px;
        drop-shadow-color: #241F1B.transparentize(0.82);
        drop-shadow-offset-y: 4px;

        feedback-text := Text {
            x: 20px;
            width: parent.width - 40px;
            text: Player.feedback;
            color: Theme.track-deep-fg;
            font-size: 13px;
            vertical-alignment: center;
            overflow: elide;
        }
    }

    // —— 播放页 overlay（M6：首屏=封面+歌词，上滑=评论；条件挂载=隐藏即卸载）———
    if Player.overlay-visible: NowPlayingOverlay {
        x: 0;
        y: 0;
        width: parent.width;
        height: parent.height;
    }

    // —— 播放列表抽屉（遮罩 + 右上浮板）———
    QueueDrawer {
        x: 0;
        y: 0;
        width: parent.width;
        height: parent.height;
    }

    // —— ESC：先关播放页 overlay，再关队列抽屉 ———
    esc-scope := FocusScope {
        key-pressed(event) => {
            if (event.text == Key.Escape) {
                if (Player.overlay_visible) {
                    Player.hide-overlay();
                    return accept;
                }
                if (Player.queue_visible) {
                    Player.hide-queue();
                    return accept;
                }
            }
            return reject;
        }
    }
}
