import { Palette } from "std-widgets.slint";
import { Theme } from "theme.slint";
import { SideBar } from "sidebar.slint";
import { PlayerBar, UiPlayback } from "player-bar.slint";
import { LoginDialog } from "login-dialog.slint";
import { LibraryPage } from "library-page.slint";
import { RecommendPage, UiLibrary } from "recommend-page.slint";
import { SearchPage, UiSong } from "search-page.slint";
import { QueuePage, UiQueue } from "queue-page.slint";
import { LyricsPage, UiLyric } from "lyrics-page.slint";
import { SettingsPage, UiFeature } from "settings-page.slint";

export { UiLibrary, UiPlayback, UiSong, UiQueue, UiLyric, UiFeature }

export component AppWindow inherits Window {
    title: "胡桃音乐";
    preferred-width: 1100px;
    preferred-height: 720px;
    min-width: 820px;
    min-height: 560px;
    background: Theme.background;

    in-out property <string> current-page: "library";
    in-out property <string> theme-mode <=> Theme.mode;
    private property <ColorScheme> palette-color-scheme <=> Palette.color-scheme;
    in-out property <[UiSong]> songs;
    in-out property <[UiLibrary]> library-items;
    in-out property <[UiLibrary]> recommend-items;
    in-out property <[UiFeature]> feature-statuses;
    in-out property <[UiQueue]> queue;
    in-out property <[UiLyric]> lyrics;
    in-out property <string> lyrics-state: "idle";
    in-out property <string> lyrics-request-mid;
    in-out property <string> lyrics-error-text;
    in-out property <string> search-text;
    in-out property <bool> search-query-valid: false;
    in-out property <bool> search-loading: false;
    in-out property <bool> search-completed: false;
    in-out property <string> search-error-text;
    in property <UiPlayback> playback;
    in property <string> current-track-id;
    in property <bool> logged-in;
    in property <string> user-name;
    in-out property <bool> show-login;
    in property <image> qr-image;
    in property <string> login-status;
    in property <image> cover-image;

    callback navigate-requested(string);
    callback queue-requested;
    callback lyrics-requested;
    callback theme-requested(string);
    callback search-query-edited(string);
    callback search-requested(string);
    callback play-requested(int);
    callback play-queue-requested(int);
    callback play-pause;
    callback next-requested;
    callback prev-requested;
    callback seek-requested(float);
    callback volume-requested(float);
    callback login-start;
    callback login-cancel;
    callback load-lyrics-requested;

    init => { root.palette-color-scheme = ColorScheme.unknown; }
    changed theme-mode => {
        root.palette-color-scheme = root.theme-mode == "light" ? ColorScheme.light
            : root.theme-mode == "dark" ? ColorScheme.dark
            : ColorScheme.unknown;
    }

    VerticalLayout {
        spacing: 0;

        HorizontalLayout {
            spacing: 0;

            SideBar {
                current-page: root.current-page;
                logged-in: root.logged-in;
                user-name: root.user-name;
                navigate-requested(page) => { root.navigate-requested(page); }
                login-start => { root.show-login = true; root.login-start(); }
            }

            Rectangle { width: 1px; background: Theme.divider; }

            Rectangle {
                horizontal-stretch: 1;
                vertical-stretch: 1;

                if root.current-page == "library": LibraryPage {
                    width: parent.width;
                    height: parent.height;
                    library-items: root.library-items;
                    playback: root.playback;
                    cover-image: root.cover-image;
                    navigate-to-search => { root.navigate-requested("search"); }
                }

                if root.current-page == "recommend": RecommendPage {
                    width: parent.width;
                    height: parent.height;
                    recommend-items: root.recommend-items;
                }

                if root.current-page == "search": SearchPage {
                    width: parent.width;
                    height: parent.height;
                    songs: root.songs;
                    search-text <=> root.search-text;
                    loading: root.search-loading;
                    completed: root.search-completed;
                    error-text: root.search-error-text;
                    query-valid: root.search-query-valid;
                    query-edited(text) => { root.search-query-edited(text); }
                    search-requested(text) => { root.search-requested(text); }
                    retry-requested => { root.search-requested(root.search-text); }
                    play-requested(idx) => { root.play-requested(idx); }
                }

                if root.current-page == "queue": QueuePage {
                    width: parent.width;
                    height: parent.height;
                    queue: root.queue;
                    play-requested(idx) => { root.play-queue-requested(idx); }
                    navigate-to-search => { root.navigate-requested("search"); }
                }

                if root.current-page == "lyrics": LyricsPage {
                    width: parent.width;
                    height: parent.height;
                    lyrics: root.lyrics;
                    lyrics-state: root.lyrics-state;
                    current-title: root.playback.title;
                    current-artist: root.playback.artist;
                    error-text: root.lyrics-error-text;
                    load-lyrics-requested => { root.load-lyrics-requested(); }
                }

                if root.current-page == "settings": SettingsPage {
                    width: parent.width;
                    height: parent.height;
                    feature-statuses: root.feature-statuses;
                    theme-mode: root.theme-mode;
                    theme-requested(mode) => { root.theme-requested(mode); }
                }
            }
        }

        PlayerBar {
            playback: root.playback;
            cover-image: root.cover-image;
            play-pause => { root.play-pause(); }
            next-requested => { root.next-requested(); }
            prev-requested => { root.prev-requested(); }
            seek-requested(value) => { root.seek-requested(value); }
            volume-requested(value) => { root.volume-requested(value); }
            queue-clicked => { root.queue-requested(); }
            lyrics-clicked => { root.lyrics-requested(); }
        }
    }

    LoginDialog {
        x: 0px;
        y: 0px;
        width: parent.width;
        height: parent.height;
        show-login: root.show-login;
        qr-image: root.qr-image;
        login-status: root.login-status;
        login-start => { root.login-start(); }
        login-cancel => { root.login-cancel(); }
        close => { root.show-login = false; }
    }
}
