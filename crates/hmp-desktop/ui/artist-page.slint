// 歌手详情（ArtistView.vue）：hero（左图右信息：返回/大名字/统计带）+ 热门歌曲
// + 专辑网格。
// 状态机渲染（M3）：0=初始 1=加载中 2=就绪 3=未找到 4=失败（离线/网络）。
// 本地投影：照片/简介/MV/相似歌手无数据源，如实缺席；远端（qq: 参数）：
// 照片 = 主页头部 singer_pic（§20/§23 边界闭合）、统计带 = 歌曲/专辑总数
// （+首窗标注）、专辑网格卡 qq:albummid 导航（二级深入）+ 异步换图。
import { Theme } from "theme.slint";
import { PageHeader, SectionHeader, CoverCardGrid } from "page-parts.slint";
import { TrackTable } from "track-table.slint";
import { Nav, Route } from "nav.slint";
import { Data } from "stores.slint";

export component ArtistPage inherits Rectangle {
    background: transparent;

    VerticalLayout {
        padding-top: Theme.space-6;
        padding-left: Theme.space-8;
        padding-right: Theme.space-8;
        padding-bottom: Theme.space-10;
        spacing: Theme.space-6;

        if Data.artist-state == 1: Text {
            height: 64px;
            text: "正在加载…";
            color: Theme.muted-foreground;
            font-size: 13.5px;
            horizontal-alignment: center;
            vertical-alignment: center;
        }

        if Data.artist-state == 3: Text {
            height: 64px;
            text: "本地媒体库中没有该歌手";
            color: Theme.muted-foreground;
            font-size: 13.5px;
            horizontal-alignment: center;
            vertical-alignment: center;
        }

        if Data.artist-state == 4: Text {
            height: 64px;
            text: "加载失败：无法连接守护进程或网络不可用";
            color: Theme.muted-foreground;
            font-size: 13.5px;
            horizontal-alignment: center;
            vertical-alignment: center;
        }

        if Data.artist-state == 2: Rectangle {
            // hero：封面照 | 页头（名字 + 统计），垂直居中。子元素勿引用
            // parent.width（布局首选宽计算成环，会解出负宽）。
            width: parent.width;
            height: 176px;

            HorizontalLayout {
                spacing: Theme.space-8;
                cross-axis-alignment: center;

                Rectangle {
                    width: 176px;
                    height: 176px;
                    border-radius: Theme.radius-lg;
                    clip: true;
                    background: Theme.muted;
                    drop-shadow-blur: 2px;
                    drop-shadow-color: #241F1B.transparentize(0.92);
                    drop-shadow-offset-y: 1px;

                    Image {
                        x: 0;
                        y: 0;
                        width: parent.width;
                        height: parent.height;
                        source: Data.artist-photo;
                        image-fit: ImageFit.cover;
                    }
                }

                PageHeader {
                    horizontal-stretch: 1;
                    title: Data.artist-name;
                    show-back: true;
                    meta-items: Data.artist-meta-items;

                    back => {
                        Nav.back();
                    }
                }
            }
        }

        if Data.artist-state == 2 && Data.artist-tracks.length > 0: VerticalLayout {
            spacing: Theme.space-4;

            SectionHeader {
                title: "歌曲";
            }
            TrackTable {
                tracks: Data.artist-tracks;
                show-header: true;
            }
        }

        if Data.artist-state == 2 && Data.artist-albums.length > 0: VerticalLayout {
            spacing: Theme.space-4;

            SectionHeader {
                title: "专辑";
            }
            CoverCardGrid {
                width: parent.width;
                cards: Data.artist-albums;
                row-count: Data.artist-albums.length;
                card-clicked(mid) => {
                    // 本地卡 mid = 专辑展示名、远端卡 mid = qq:albummid——
                    // 两者都是 Route.album 的合法参数（apply_route 自行分流）
                    Nav.navigate(Route.album, mid);
                }
            }
        }

        if Data.artist-state == 2 && Data.artist-tracks.length == 0 && Data.artist-albums.length == 0: Text {
            height: 64px;
            text: "该歌手在本地媒体库中暂无曲目";
            color: Theme.muted-foreground;
            font-size: 14px;
            horizontal-alignment: center;
            vertical-alignment: center;
        }
    }
}
