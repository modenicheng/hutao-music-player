// 搜索页：smartbox 快速搜索（daemon Search IPC，免登录）。
// 数据源无时长/专辑列 → 表格收起两列；结果行点击 → 播放该曲。
// 状态机：0=初始 1=搜索中 2=有结果 3=无结果 4=失败（离线/网络错误）。
import { Theme } from "theme.slint";
import { Icons } from "icons.slint";
import { AppIcon, Button, ButtonVariant } from "primitives.slint";
import { PageHeader } from "page-parts.slint";
import { TrackTable } from "track-table.slint";
import { Data } from "stores.slint";

export component SearchPage inherits Rectangle {
    background: transparent;

    VerticalLayout {
        padding-top: Theme.space-6;
        padding-left: Theme.space-8;
        padding-right: Theme.space-8;
        padding-bottom: Theme.space-10;
        spacing: Theme.space-4;

        PageHeader {
            title: "搜索";
            show-back: false;
        }

        // —— 搜索框（回车或按钮触发；不做即时搜索）———
        Rectangle {
            height: 44px;
            border-radius: Theme.radius-md;
            border-width: 1px;
            border-color: input.has-focus ? Theme.primary : Theme.border;
            background: Theme.surface-2;

            HorizontalLayout {
                padding-left: Theme.space-4;
                padding-right: 6px;
                spacing: Theme.space-3;
                alignment: LayoutAlignment.center;

                AppIcon {
                    source: Icons.search;
                    icon-color: Theme.muted-foreground;
                    width: 19px;
                    height: 19px;
                }

                input := TextInput {
                    text: Data.search-query;
                    font-size: 14.5px;
                    color: Theme.foreground;
                    vertical-alignment: center;
                    horizontal-stretch: 1;
                    accepted => {
                        Data.search(self.text);
                    }
                    edited => {
                        // 输入同步到全局（切页回来保留关键词）
                        Data.search-query = self.text;
                    }
                }

                Button {
                    variant: ButtonVariant.default;
                    text: "搜索";
                    small: true;
                    enabled: Data.search-state != 1 && input.text != "";
                    clicked => {
                        Data.search(input.text);
                    }
                }
            }
        }

        // —— 结果 / 状态———
        if Data.search-state == 1: Text {
            height: 64px;
            text: "搜索中…";
            color: Theme.muted-foreground;
            font-size: 13.5px;
            horizontal-alignment: center;
            vertical-alignment: center;
        }
        if Data.search-state == 3: Text {
            height: 64px;
            text: "没有找到「\{Data.search-query}」的相关结果";
            color: Theme.muted-foreground;
            font-size: 13.5px;
            horizontal-alignment: center;
            vertical-alignment: center;
        }
        if Data.search-state == 4: Text {
            height: 64px;
            text: "搜索失败：无法连接守护进程或网络不可用";
            color: Theme.muted-foreground;
            font-size: 13.5px;
            horizontal-alignment: center;
            vertical-alignment: center;
        }
        if Data.search-state == 0: Text {
            height: 64px;
            text: "输入关键词搜索 QQ 音乐曲库";
            color: Theme.muted-foreground;
            font-size: 13.5px;
            horizontal-alignment: center;
            vertical-alignment: center;
        }

        if Data.search-state == 2: TrackTable {
            tracks: Data.search-results;
            show-header: true;
            show-album: false;
            show-duration: false;
        }
    }
}
