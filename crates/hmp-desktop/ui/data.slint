// UI 数据结构（契约对齐 apps/hmp-tauri/src/lib/api/types.ts，DESIGN.md §4）。
// Slint struct 无嵌套数组：多人合唱的歌手串为展示文本，链接统一指向主歌手（PORTING.md 决策 5）。

/** 曲目表/队列行（SongRef 摊平）。播放态经 Player.queue-current-mid 比对 mid */
export struct TrackRow {
    /** 源键：QQ 曲目 = songmid；本地曲目 = `local:<路径>`（PlayRequest 映射用） */
    mid: string,
    /** 源：0=QQ，1=本地（`hmp_core::PlayRequest` 分流） */
    source: int,
    title: string,
    /** 展示串："白栖遥 / 陈屿帆"（点击整体跳主歌手页，PORTING.md 决策 5） */
    artists: string,
    /** 主歌手 mid */
    artist-mid: string,
    album: string,
    album-mid: string,
    duration-ms: int,
    /** 音质徽章文案，如 "FLAC · 44.1kHz"；无损以下为空 */
    quality: string,
    cover: image,
}

/** 封面卡（歌单/专辑/已购专辑网格） */
export struct CoverCardData {
    mid: string,
    title: string,
    /** 副标题，如 "12 首 · 2026-08-30 购买" */
    subtitle: string,
    cover: image,
}

/** 本地监视文件夹行（WatchedFolder） */
export struct FolderRow {
    path: string,
    track-count: int,
    size-text: string,
    last-scan: string,
}

/** 侧栏歌单条目（名称 + 确定性渐变取色，Rust 侧派生） */
export struct PlaylistCover {
    /** 歌单 id：行点击跳歌单详情的导航参数（与库页歌单卡 mid 同一字符串形式） */
    id: string,
    name: string,
    c1: color,
    c2: color,
}

/** 歌词行（LRC 行级时间轴；桌面 lyrics.rs 解析） */
export struct LyricRow {
    /** 行起始时间（毫秒），点击行 seek 用 */
    timestamp-ms: int,
    text: string,
    /** 翻译行（无翻译为空串，不占位） */
    translation: string,
}

/** 评论条目（daemon CommentItem 展示投影；时间/点赞数 Rust 侧格式化） */
export struct CommentRow {
    cm-id: string,
    nickname: string,
    /** 头像占位首字（昵称首字符，UI 禁网不拉真头像） */
    initial: string,
    content: string,
    time-text: string,
    like-text: string,
}

/** 排行榜卡片（TopSummaryDto 展示投影；preview 为预览前 3 首文案） */
export struct TopCardData {
    id: string,
    name: string,
    title-sub: string,
    update-time: string,
    listen-num: int,
    preview: [string],
}

/** 排行榜分组（TopGroupDto 展示投影） */
export struct TopGroupData {
    id: string,
    name: string,
    tops: [TopCardData],
}
