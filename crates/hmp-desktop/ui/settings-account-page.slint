// 账号设置（AccountSettingsView.vue 的诚实版）：账号状态读接口未接入
// （docs/AUDIT.md §8.6，daemon 未暴露登录态/昵称/VIP 查询）——资料占位、
// 退出登录禁用，不伪造用户资料。
import { Theme } from "theme.slint";
import { Icons } from "icons.slint";
import { AppIcon, Button, ButtonVariant } from "primitives.slint";
import { PageHeader, FactRow } from "page-parts.slint";
import { SettingsNav, SettingGroup } from "settings-parts.slint";
import { Nav } from "nav.slint";

export component SettingsAccountPage inherits Rectangle {
    background: transparent;

    VerticalLayout {
        padding-top: Theme.space-6;
        padding-left: Theme.space-8;
        padding-right: Theme.space-8;
        padding-bottom: Theme.space-10;
        spacing: Theme.space-4;
        max-width: 896px;

        PageHeader {
            title: "账号设置";
            show-back: true;
            back => {
                Nav.back();
            }
        }

        SettingsNav { }

        // —— 资料卡（头像 + 未接入文案 + 禁用退出）———
        Rectangle {
            height: 96px;
            border-radius: Theme.radius-lg;
            background: Theme.surface-3;
            drop-shadow-blur: 2px;
            drop-shadow-color: #241F1B.transparentize(0.92);
            drop-shadow-offset-y: 1px;

            HorizontalLayout {
                padding-left: Theme.space-5;
                padding-right: Theme.space-5;
                spacing: Theme.space-4;
                cross-axis-alignment: center;

                Rectangle {
                    width: 52px;
                    height: 52px;
                    border-radius: Theme.radius-full;
                    background: Theme.muted;

                    AppIcon {
                        source: Icons.account_circle;
                        icon-color: Theme.primary;
                        width: 28px;
                        height: 28px;
                        x: (parent.width - self.width) / 2;
                        y: (parent.height - self.height) / 2;
                    }
                }

                VerticalLayout {
                    horizontal-stretch: 1;
                    alignment: LayoutAlignment.center;
                    spacing: 3px;

                    Text {
                        text: "账号未接入";
                        color: Theme.foreground;
                        font-size: 16.8px;
                        font-weight: 650;
                    }
                    Text {
                        text: "云端账号同步与登录流将在后续版本接入";
                        color: Theme.muted-foreground;
                        font-size: 12.8px;
                    }
                }

                Button {
                    variant: ButtonVariant.outline;
                    small: true;
                    text: "退出登录";
                    enabled: false;
                    tool-tip: "账号体系尚未接入，退出登录即将上线";
                    height: 32px;
                }
            }
        }

        // —— 信息行（只读；无接口的值诚实显示 "—"）———
        SettingGroup {
            title: "账号信息";

            FactRow {
                label: "昵称";
                value: "—";
            }
            FactRow {
                label: "会员状态";
                value: "—";
            }
            FactRow {
                label: "数据来源";
                value: "等待后端账号接口";
            }
        }

        Text {
            text: "播放/收藏等操作经由本地守护进程完成，无需登录即可使用本地音乐库。";
            color: Theme.muted-foreground;
            font-size: 12.8px;
        }
    }
}
