// 账号设置（AccountSettingsView.vue）：数据 = daemon AccountStatus IPC
// （docs/AUDIT.md §8.6 已补——登录态 + 昵称/uin/VIP 摘要；未登录诚实展示
// 登录引导）。登录/退出流程仍属 CLI（`hmp login`），桌面不做凭证操作。
import { Theme } from "theme.slint";
import { Icons } from "icons.slint";
import { AppIcon, Button, ButtonVariant } from "primitives.slint";
import { PageHeader, FactRow } from "page-parts.slint";
import { SettingsNav, SettingGroup } from "settings-parts.slint";
import { Nav } from "nav.slint";
import { Data } from "stores.slint";

export component SettingsAccountPage inherits Rectangle {
    background: transparent;

    VerticalLayout {
        padding-top: Theme.space-6;
        padding-left: Theme.space-8;
        padding-right: Theme.space-8;
        padding-bottom: Theme.space-10;
        spacing: Theme.space-4;
        max-width: 896px;

        PageHeader {
            title: "账号设置";
            show-back: true;
            back => {
                Nav.back();
            }
        }

        SettingsNav { }

        // —— 资料卡（头像 + 登录态/昵称 + 退出（登录流未入桌面，禁用））———
        Rectangle {
            height: 96px;
            border-radius: Theme.radius-lg;
            background: Theme.surface-3;
            drop-shadow-blur: 2px;
            drop-shadow-color: #241F1B.transparentize(0.92);
            drop-shadow-offset-y: 1px;

            HorizontalLayout {
                padding-left: Theme.space-5;
                padding-right: Theme.space-5;
                spacing: Theme.space-4;
                cross-axis-alignment: center;

                Rectangle {
                    width: 52px;
                    height: 52px;
                    border-radius: Theme.radius-full;
                    background: Theme.muted;

                    AppIcon {
                        source: Icons.account_circle;
                        icon-color: Theme.primary;
                        width: 28px;
                        height: 28px;
                        x: (parent.width - self.width) / 2;
                        y: (parent.height - self.height) / 2;
                    }
                }

                VerticalLayout {
                    horizontal-stretch: 1;
                    alignment: LayoutAlignment.center;
                    spacing: 3px;

                    Text {
                        text: Data.account-state == 0 ? "读取账号状态中…"
                            : Data.account-state == 2 ? "守护进程不可达"
                            : Data.account-logged-in ? Data.account-nickname
                            : "未登录";
                        color: Theme.foreground;
                        font-size: 16.8px;
                        font-weight: 650;
                    }
                    Text {
                        text: Data.account-state == 0 ? "正在向守护进程查询"
                            : Data.account-state == 2 ? "启动 hmp 守护进程后重进此页"
                            : Data.account-logged-in ? "QQ 音乐 · 已登录"
                            : "登录后可同步云端歌单与收藏";
                        color: Theme.muted-foreground;
                        font-size: 12.8px;
                    }
                }

                if Data.account-logged-in: Button {
                    variant: ButtonVariant.outline;
                    small: true;
                    text: "退出登录";
                    enabled: false;
                    tool-tip: "桌面端登录/退出流未接入；请在终端运行 hmp login / hmp logout";
                    height: 32px;
                }
            }
        }

        // —— 信息行（只读；接口没给的值诚实显示 "—"）———
        SettingGroup {
            title: "账号信息";

            FactRow {
                label: "昵称";
                value: Data.account-logged-in ? Data.account-nickname : "—";
            }
            FactRow {
                label: "QQ 号";
                value: Data.account-logged-in ? Data.account-uin : "—";
            }
            FactRow {
                label: "会员状态";
                value: Data.account-logged-in && Data.account-vip != ""
                    ? Data.account-vip
                    : "—";
            }
            FactRow {
                label: "数据来源";
                value: Data.account-state == 2 ? "守护进程不可达" : "守护进程 AccountStatus 接口";
            }
        }

        if !Data.account-logged-in && Data.account-state == 1: SettingGroup {
            title: "登录方式";

            FactRow {
                label: "命令行登录";
                value: "hmp login";
            }
            Text {
                text: "扫码登录暂未进入桌面端；在终端完成 `hmp login` 后回到此页刷新即可看到账号。";
                color: Theme.muted-foreground;
                font-size: 12.8px;
            }
        }

        Text {
            text: "播放/收藏等操作经由本地守护进程完成，无需登录即可使用本地音乐库。";
            color: Theme.muted-foreground;
            font-size: 12.8px;
        }
    }
}
