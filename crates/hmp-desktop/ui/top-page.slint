// 排行榜页（M4 在线内容页）：分组榜单卡片——daemon
// TopCategoryGet IPC（免登录）。点击榜单进入 top-detail 详情。
import { Theme } from "theme.slint";
import { Button, ButtonVariant } from "primitives.slint";
import { PageHeader } from "page-parts.slint";
import { Nav, Route } from "nav.slint";
import { Data } from "stores.slint";
import { TopCardData } from "data.slint";

// 单个榜单卡片：名称 + 期号 + 预览前 3 首。
component TopCard inherits Rectangle {
    in property <TopCardData> card;
    callback clicked();

    width: 260px;
    height: 148px;
    border-radius: Theme.radius-md;
    // 悬停底色（浅一层）
    background: touch.has-hover ? Theme.surface-3 : Theme.surface-2;

    touch := TouchArea {
        clicked => {
            root.clicked();
        }
    }

    VerticalLayout {
        y: 12px;
        height: parent.height - 24px;
        width: parent.width - 24px;
        x: 12px;
        spacing: 2px;

        Text {
            text: card.name;
            color: Theme.foreground;
            font-size: 15px;
            font-weight: 700;
            overflow: elide;
        }

        Text {
            text: card.title-sub == "" ? card.update-time : card.title-sub + " · " + card.update-time;
            color: Theme.muted-foreground;
            font-size: 12px;
            overflow: elide;
        }

        Rectangle { height: 4px; }

        Text {
            text: card.preview.length > 0 ? card.preview[0] : "";
            color: Theme.muted-foreground;
            font-size: 12.5px;
            overflow: elide;
        }
        Text {
            text: card.preview.length > 1 ? card.preview[1] : "";
            color: Theme.muted-foreground;
            font-size: 12.5px;
            overflow: elide;
        }
        Text {
            text: card.preview.length > 2 ? card.preview[2] : "";
            color: Theme.muted-foreground;
            font-size: 12.5px;
            overflow: elide;
        }
    }
}

export component TopPage inherits Rectangle {

    VerticalLayout {
        y: Theme.space-4;
        height: parent.height - 2 * Theme.space-4;
        width: parent.width - 2 * Theme.space-4;
        x: Theme.space-4;
        spacing: Theme.space-4;

        HorizontalLayout {
            height: 56px;
            spacing: Theme.space-4;

            Rectangle {
                width: parent.width - 120px;

                Text {
                    text: "排行榜";
                    color: Theme.foreground;
                    font-size: 22px;
                    font-weight: 700;
                    vertical-alignment: center;
                }
            }

            Rectangle {
                Button {
                    text: Data.top-state == 1 ? "加载中…" : "刷新";
                    variant: ButtonVariant.outline;
                    width: 96px;
                    y: (parent.height - self.height) / 2;
                    clicked => {
                        Data.refresh-top();
                    }
                }
            }
        }

        // 状态机同发现页：0=初始 1=加载中 2=有内容 3=空 4=失败
        if Data.top-state == 0 || Data.top-state == 1: Rectangle {
            height: 160px;

            Text {
                width: parent.width;
                y: 64px;
                text: Data.top-state == 1 ? "正在加载排行榜…" : "即将加载…";
                color: Theme.muted-foreground;
                font-size: 14px;
                horizontal-alignment: center;
            }
        }

        if Data.top-state == 3 || Data.top-state == 4: Rectangle {
            height: 160px;

            Text {
                width: parent.width;
                y: 48px;
                text: Data.top-state == 4 ? "加载失败（离线或网络异常）" : "暂无榜单";
                color: Theme.muted-foreground;
                font-size: 14px;
                horizontal-alignment: center;
            }
        }

        if Data.top-state == 2: Flickable {
            VerticalLayout {
                spacing: Theme.space-4;

                // 按分组渲染（水平滚动行内的榜单卡片）
                for group in Data.top-groups: Rectangle {
                    height: 232px;

                    Text {
                        y: 0;
                        text: group.name;
                        color: Theme.foreground;
                        font-size: 16px;
                        font-weight: 700;
                    }

                    // 横向滚动条：分组内卡片行
                    Flickable {
                        y: 32px;
                        width: parent.width;
                        height: parent.height - 32px;

                        HorizontalLayout {
                            x: 8px;
                            spacing: Theme.space-4;

                            for top-i in group.tops: TopCard {
                                card: top-i;
                                clicked => {
                                    // top id 以字符串放进路由参数
                                    Nav.navigate(Route.top-detail, top-i.id + "");
                                }
                            }
                        }
                    }
                }
            }
        }
    }
}
