// 排行榜页（M4 在线内容页）：分组榜单卡片——daemon
// TopCategoryGet IPC（免登录）。点击榜单卡片进入 top-detail 详情。
// 内容自撑高度（Scroll 约定，禁 parent.height）。
import { Theme } from "theme.slint";
import { Button, ButtonVariant } from "primitives.slint";
import { PageHeader, SectionHeader } from "page-parts.slint";
import { Nav, Route } from "nav.slint";
import { Data } from "stores.slint";
import { TopCardData } from "data.slint";
import { Viewport } from "viewport.slint";

// 单个榜单卡（T5/D-8）：封面（4:3、radius-lg、阴影、hover 浮起）+
// 右下「N 首」角标 + 名 + 更新时间 + 预览前 3 首（DESIGN §3.2 完整卡）。
component TopCard inherits Rectangle {
    in property <TopCardData> card;
    // 列宽由网格容器按窗口宽算好传入（280px 为最大卡宽，窄窗按比例缩）
    in property <length> card-width: 280px;
    callback clicked();

    width: root.card-width;
    // 封面 4:3 + 间距 + 名/更新/预览文本区
    height: root.card-width * 0.75 + 118px;
    border-radius: Theme.radius-lg;
    drop-shadow-blur: touch.has-hover ? 8px : 2px;
    drop-shadow-color: #241F1B.transparentize(touch.has-hover ? 0.86 : 0.92);
    drop-shadow-offset-y: touch.has-hover ? 2px : 1px;
    // 悬停阴影缓动过渡，避免 2px→8px 突跳
    animate drop-shadow-blur {
        duration: Theme.duration-fast;
        easing: cubic-bezier(0.2, 0, 0, 1);
    }
    animate drop-shadow-offset-y {
        duration: Theme.duration-fast;
        easing: cubic-bezier(0.2, 0, 0, 1);
    }
    animate drop-shadow-color {
        duration: Theme.duration-fast;
        easing: cubic-bezier(0.2, 0, 0, 1);
    }
    background: Theme.surface-3;

    touch := TouchArea {
        clicked => {
            root.clicked();
        }
    }

    VerticalLayout {
        padding-left: Theme.space-3;
        padding-right: Theme.space-3;
        padding-top: Theme.space-3;
        padding-bottom: Theme.space-3;
        spacing: 3px;

        // —— 封面（4:3；占位 → CoverGet 换真图渐进）———
        Rectangle {
            height: root.card-width * 0.75;
            border-radius: Theme.radius-lg;
            clip: true;
            background: Theme.muted;

            Image {
                x: 0;
                y: 0;
                width: parent.width;
                height: parent.height;
                source: root.card.cover;
                image-fit: ImageFit.cover;
            }

            // 「N 首」角标（B3；total-num=0 未知不展示）
            if root.card.total-num > 0: Rectangle {
                x: parent.width - self.width - 8px;
                y: parent.height - self.height - 8px;
                width: badge-text.preferred-width + 14px;
                height: 20px;
                border-radius: Theme.pill(self.height);
                background: #241F1B.transparentize(0.35);

                badge-text := Text {
                    width: parent.width;
                    height: parent.height;
                    text: root.card.total-num + " 首";
                    color: #FAF9F8;
                    font-size: 11px;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }
            }
        }

        Text {
            text: root.card.name;
            color: Theme.foreground;
            font-size: 14.5px;
            font-weight: 700;
            overflow: elide;
        }

        Text {
            text: root.card.update-time == "" ? "" : "更新 " + root.card.update-time;
            color: Theme.muted-foreground;
            font-size: 11.5px;
            overflow: elide;
        }

        Text {
            text: root.card.preview.length > 0 ? root.card.preview[0] : "";
            color: Theme.muted-foreground;
            font-size: 12px;
            overflow: elide;
        }
        Text {
            text: root.card.preview.length > 1 ? root.card.preview[1] : "";
            color: Theme.muted-foreground;
            font-size: 12px;
            overflow: elide;
        }
        Text {
            text: root.card.preview.length > 2 ? root.card.preview[2] : "";
            color: Theme.muted-foreground;
            font-size: 12px;
            overflow: elide;
        }
    }
}

export component TopPage inherits Rectangle {
    background: transparent;

    VerticalLayout {
        padding-top: Theme.space-6;
        padding-left: Theme.space-8;
        padding-right: Theme.space-8;
        padding-bottom: Theme.space-10;
        spacing: Theme.space-6;

        PageHeader {
            title: "排行榜";

            // 页面级主动作放页头动作区（加载中不显示，避免与下方加载块双文案）
            if Data.top-state != 1: Button {
                text: "刷新";
                variant: ButtonVariant.outline;
                clicked => {
                    Data.refresh-top();
                }
            }
        }

        // 加载块仅在无内容可保留时显示：刷新已有内容时旧榜单原地保留不闪加载
        if Data.top-state == 0 || (Data.top-state == 1 && Data.top-groups.length == 0): Rectangle {
            height: 200px;

            Text {
                y: 80px;
                width: parent.width;
                text: "正在加载…";
                color: Theme.muted-foreground;
                font-size: 14px;
                horizontal-alignment: center;
            }
        }

        if Data.top-state == 3 || Data.top-state == 4: Rectangle {
            height: 200px;

            VerticalLayout {
                alignment: center;

                Text {
                    text: Data.top-state == 4 ? "加载失败" : "暂无榜单";
                    color: Theme.foreground;
                    font-size: 15px;
                    horizontal-alignment: center;
                }
                Text {
                    text: Data.top-state == 4 ? "离线或网络异常，点击右上角刷新重试" : "";
                    color: Theme.muted-foreground;
                    font-size: 13px;
                    horizontal-alignment: center;
                }
            }
        }

        // 分组渲染：组标题 + 榜单卡换行网格（HorizontalLayout 不换行会溢出
        // 裁掉，照 CoverCardGrid 的「按容器宽算列数 + 绝对定位」模式摆卡）
        if Data.top-state == 2 || (Data.top-state == 1 && Data.top-groups.length > 0): VerticalLayout {
            spacing: Theme.space-8;

            for group in Data.top-groups: VerticalLayout {
                spacing: Theme.space-4;

                SectionHeader {
                    title: group.name;
                }

                Rectangle {
                    background: transparent;
                    // 行数自撑容器高度（Scroll content VerticalLayout preferred-height 生效）；
                    // 卡高随列宽动态（封面 4:3 + 文本区，D-8）
                    height: rows > 0 ? rows * card-h + (rows - 1) * 16px : 0px;

                    property <int> cols: Math.max(1, Math.ceil((self.width + 16px) / 296px));
                    property <int> rows: Math.ceil(group.tops.length / cols);
                    property <length> card-h: card-w * 0.75 + 118px;
                    // 280px 为最大卡宽，窄窗按比例缩
                    property <length> card-w: Math.min(280px, (self.width - (cols - 1) * 16px) / cols);

                    // —— 行窗（窗口化虚拟化，模式同 track-table MEMFIX ④a）———
                    // 本页挂在顶层 page-scroll 之下，滚动状态直接复用 Viewport
                    // 全局。依赖链单向：高度只依赖 group.tops.length（滚动条
                    // 几何与全量渲染一致）；窗口量只依赖 Viewport 与组卡数，
                    // 绝不反向掺入（否则与滚动偏移绑定成环）。外层 group 循环
                    // 每轮各有独立作用域，窗口属性挂在网格容器上天然隔离。
                    property <length> row-pitch: card-h + 16px;
                    // 网格顶在内容系 y：absolute-position 是窗口系且含滚动偏移
                    // （活依赖），减 origin-y 与 Viewport.y 恰好抵消滚动位移——
                    // 结果为恒定内容坐标，滚动逐帧自动重算
                    property <length> grid-top: self.absolute-position.y - Viewport.origin-y - Viewport.y;
                    property <int> row-start: Viewport.view-h <= 0px ? 0
                        : clamp(
                            Math.floor((-Viewport.y - grid-top) / row-pitch) - 2,
                            0,
                            Math.max(rows - 1, 0),
                        );
                    property <int> visible-rows: Viewport.view-h <= 0px ? rows
                        : Math.min(rows - row-start, Math.ceil(Viewport.view-h / row-pitch) + 4);
                    property <int> first-index: row-start * cols;
                    property <int> card-count: Math.min(
                        Math.max(group.tops.length - first-index, 0),
                        visible-rows * cols,
                    );

                    // 卡按绝对索引绝对定位；offset 只是窗口内序号，数据与跳转
                    // 一律经 first-index 换算回整表下标（rowd）
                    for offset in card-count: TopCard {
                        property <TopCardData> rowd: group.tops[first-index + offset];
                        card: rowd;
                        card-width: card-w;
                        x: Math.mod(first-index + offset, cols) * (card-w + 16px);
                        y: Math.floor((first-index + offset) / cols) * (card-h + 16px);
                        clicked => {
                            Nav.navigate(Route.top-detail, rowd.id);
                        }
                    }
                }
            }
        }
    }
}
