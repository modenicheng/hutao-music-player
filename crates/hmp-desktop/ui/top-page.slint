// 排行榜页（M4 在线内容页）：分组榜单卡片——daemon
// TopCategoryGet IPC（免登录）。点击榜单卡片进入 top-detail 详情。
// 内容自撑高度（Scroll 约定，禁 parent.height）。
import { Theme } from "theme.slint";
import { Button, ButtonVariant } from "primitives.slint";
import { PageHeader, SectionHeader } from "page-parts.slint";
import { Nav, Route } from "nav.slint";
import { Data } from "stores.slint";
import { TopCardData } from "data.slint";

// 单个榜单卡：名称 + 期号 + 预览前 3 首（悬停浮起）。
component TopCard inherits Rectangle {
    in property <TopCardData> card;
    callback clicked();

    width: 280px;
    height: 156px;
    border-radius: Theme.radius-lg;
    drop-shadow-blur: touch.has-hover ? 8px : 2px;
    drop-shadow-color: #241F1B.transparentize(touch.has-hover ? 0.86 : 0.92);
    drop-shadow-offset-y: touch.has-hover ? 2px : 1px;
    background: Theme.surface-3;

    touch := TouchArea {
        clicked => {
            root.clicked();
        }
    }

    VerticalLayout {
        padding-left: Theme.space-5;
        padding-right: Theme.space-5;
        padding-top: Theme.space-4;
        padding-bottom: Theme.space-4;
        spacing: 4px;

        Text {
            text: root.card.name;
            color: Theme.foreground;
            font-size: 15px;
            font-weight: 700;
            overflow: elide;
        }

        Text {
            text: root.card.update-time == "" ? "" : "更新 " + root.card.update-time;
            color: Theme.muted-foreground;
            font-size: 11.5px;
            overflow: elide;
        }

        Rectangle { height: 4px; }

        Text {
            text: root.card.preview.length > 0 ? root.card.preview[0] : "";
            color: Theme.muted-foreground;
            font-size: 12.5px;
            overflow: elide;
        }
        Text {
            text: root.card.preview.length > 1 ? root.card.preview[1] : "";
            color: Theme.muted-foreground;
            font-size: 12.5px;
            overflow: elide;
        }
        Text {
            text: root.card.preview.length > 2 ? root.card.preview[2] : "";
            color: Theme.muted-foreground;
            font-size: 12.5px;
            overflow: elide;
        }
    }
}

export component TopPage inherits Rectangle {
    background: transparent;

    VerticalLayout {
        padding-top: Theme.space-6;
        padding-left: Theme.space-8;
        padding-right: Theme.space-8;
        padding-bottom: Theme.space-10;
        spacing: Theme.space-6;

        PageHeader {
            title: "排行榜";
        }

        // 页头动作区（独立行）
        HorizontalLayout {
            alignment: end;

            if Data.top-state == 1: Text {
                text: "正在加载…";
                color: Theme.muted-foreground;
                font-size: 13px;
            }
            if Data.top-state != 1: Button {
                text: "刷新";
                variant: ButtonVariant.outline;
                clicked => {
                    Data.refresh-top();
                }
            }
        }

        if Data.top-state == 0 || Data.top-state == 1: Rectangle {
            height: 200px;

            Text {
                y: 80px;
                width: parent.width;
                text: "正在加载…";
                color: Theme.muted-foreground;
                font-size: 14px;
                horizontal-alignment: center;
            }
        }

        if Data.top-state == 3 || Data.top-state == 4: Rectangle {
            height: 200px;

            VerticalLayout {
                alignment: center;

                Text {
                    text: Data.top-state == 4 ? "加载失败" : "暂无榜单";
                    color: Theme.foreground;
                    font-size: 15px;
                    horizontal-alignment: center;
                }
                Text {
                    text: Data.top-state == 4 ? "离线或网络异常，点击右上角刷新重试" : "";
                    color: Theme.muted-foreground;
                    font-size: 13px;
                    horizontal-alignment: center;
                }
            }
        }

        // 分组渲染：组标题 + 榜单卡片流（HorizontalLayout 自动换行不可用，
        // 每组一行多卡，超出屏宽可由页面整体滚动承载）
        if Data.top-state == 2: VerticalLayout {
            spacing: Theme.space-8;

            for group in Data.top-groups: VerticalLayout {
                spacing: Theme.space-4;

                SectionHeader {
                    title: group.name;
                }

                HorizontalLayout {
                    spacing: Theme.space-4;

                    for top-i in group.tops: TopCard {
                        card: top-i;
                        clicked => {
                            Nav.navigate(Route.top-detail, top-i.id);
                        }
                    }
                }
            }
        }
    }
}
