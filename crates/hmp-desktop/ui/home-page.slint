// 首页（M4 在线内容页）：问候 + 猜你喜欢（需登录）+ 为你推荐（免登录歌单）。
// GuessGet/DiscoverGet 数据；发现页加载后同源展示。
// 内容自撑高度（Scroll 约定，禁 parent.height）。
import { Theme } from "theme.slint";
import { Button, ButtonVariant } from "primitives.slint";
import { SectionHeader, CoverCard } from "page-parts.slint";
import { TrackTable } from "track-table.slint";
import { Nav, Route } from "nav.slint";
import { Data, Player } from "stores.slint";

export component HomePage inherits Rectangle {
    background: transparent;

    VerticalLayout {
        padding-top: Theme.space-6;
        padding-left: Theme.space-8;
        padding-right: Theme.space-8;
        padding-bottom: Theme.space-10;
        spacing: Theme.space-6;

        // 页头：标题 + 快捷入口
        HorizontalLayout {
            height: 56px;
            spacing: Theme.space-4;

            Text {
                text: "首页";
                color: Theme.foreground;
                font-size: 22px;
                font-weight: 700;
                vertical-alignment: center;
                horizontal-stretch: 1;
            }

            Button {
                text: "去发现";
                variant: ButtonVariant.outline;
                y: (parent.height - self.height) / 2;
                clicked => {
                    Nav.navigate(Route.discover, "");
                }
            }

            Button {
                text: "看榜单";
                variant: ButtonVariant.outline;
                y: (parent.height - self.height) / 2;
                clicked => {
                    Nav.navigate(Route.top, "");
                }
            }
        }

        // —— 猜你喜欢（需登录；未登录显示引导卡）——
        VerticalLayout {
            spacing: Theme.space-4;

            SectionHeader {
                title: "猜你喜欢";
            }

            if Data.guess-state == 1: Text {
                text: "正在加载…";
                color: Theme.muted-foreground;
                font-size: 13px;
            }

            if !Data.account-logged-in && Data.guess-state != 2: Rectangle {
                height: 88px;
                border-radius: Theme.radius-lg;
                background: Theme.surface-2;

                Text {
                    y: (parent.height - self.height) / 2;
                    width: parent.width;
                    text: "登录后可获取个性化推荐（设置 → 账号，或 CLI：hmp login）";
                    color: Theme.muted-foreground;
                    font-size: 13.5px;
                    horizontal-alignment: center;
                }
            }

            if Data.guess-state == 4: Text {
                text: "加载失败";
                color: Theme.muted-foreground;
                font-size: 13px;
            }

            if Data.guess-state == 2 && Data.guess-tracks.length > 0: TrackTable {
                tracks: Data.guess-tracks;
                show-duration: true;
            }
        }

        // —— 为你推荐（复用发现页歌单数据；同源免登录）——
        if Data.discover-state == 2 && Data.discover-playlists.length > 0: VerticalLayout {
            spacing: Theme.space-4;

            SectionHeader {
                title: "为你推荐";
                more-to: "更多";
                more-clicked => {
                    Nav.navigate(Route.discover, "");
                }
            }

            cards-grid := HorizontalLayout {
                spacing: 16px;

                for card[i] in Data.discover-playlists: CoverCard {
                    width: Theme.grid-card-width(cards-grid.width);
                    cover: card.cover;
                    title: card.title;
                    subtitle: card.subtitle;
                    clicked => {
                        Nav.navigate(Route.playlist, card.mid);
                    }
                }
            }
        }

        // 发现页尚未加载时的占位（首页惰性触发会很快被替换）
        if Data.discover-state == 0 || Data.discover-state == 1: Text {
            text: "正在获取推荐内容…";
            color: Theme.muted-foreground;
            font-size: 13px;
        }
    }
}
