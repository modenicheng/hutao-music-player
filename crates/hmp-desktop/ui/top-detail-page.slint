// 排行榜详情页（M4 在线内容页）：榜单曲目列表——daemon
// TopDetailGet IPC（免登录）。Nav.param 携带 top id。
// 内容自撑高度（Scroll 约定，禁 parent.height）。
import { Theme } from "theme.slint";
import { Button, ButtonVariant } from "primitives.slint";
import { PageHeader } from "page-parts.slint";
import { TrackTable } from "track-table.slint";
import { Nav } from "nav.slint";
import { Data, Player } from "stores.slint";

export component TopDetailPage inherits Rectangle {
    background: transparent;

    VerticalLayout {
        padding-top: Theme.space-6;
        padding-left: Theme.space-8;
        padding-right: Theme.space-8;
        padding-bottom: Theme.space-10;
        spacing: Theme.space-4;

        PageHeader {
            title: Data.top-detail-found ? Data.top-detail-name : "排行榜详情";
            show-back: Nav.can-go-back;
            back => {
                Nav.back();
            }
            // meta 项按状态整组切换：PageHeader 会对 index>0 无条件渲染「·」
            // 分隔符，传空串元素会渲染成孤立「·」，故只在值非空时才含该元素
            meta-items: !Data.top-detail-found ? []
                : Data.top-detail-update == "" ? [Data.top-detail-total + " 首"]
                : [Data.top-detail-total + " 首", "更新 " + Data.top-detail-update];
        }

        // 页头动作区（独立行；仅有内容时显示）
        if Data.top-detail-found && Data.top-detail-tracks.length > 0: HorizontalLayout {
            alignment: end;

            Button {
                text: "播放全部";
                variant: ButtonVariant.default;
                clicked => {
                    Player.play-tracks(Data.top-detail-tracks, 0);
                }
            }
        }

        // 状态机：0=初始 1=加载中 2=有内容 3=空 4=失败
        if Data.top-detail-state == 0 || Data.top-detail-state == 1: Rectangle {
            height: 200px;

            Text {
                y: 80px;
                width: parent.width;
                text: "正在加载…";
                color: Theme.muted-foreground;
                font-size: 14px;
                horizontal-alignment: center;
            }
        }

        if Data.top-detail-state == 3 || Data.top-detail-state == 4: Rectangle {
            height: 200px;

            Text {
                y: 76px;
                width: parent.width;
                text: Data.top-detail-state == 4 ? "加载失败（离线或网络异常）" : "暂无曲目";
                color: Theme.muted-foreground;
                font-size: 14px;
                horizontal-alignment: center;
            }
        }

        if Data.top-detail-state == 2 && Data.top-detail-tracks.length > 0: TrackTable {
            tracks: Data.top-detail-tracks;
            show-duration: true;
        }
    }
}
