// 排行榜详情页（M4 在线内容页）：榜单曲目列表——daemon
// TopDetailGet IPC（免登录）。Nav.param 携带 top id。
import { Theme } from "theme.slint";
import { Button, ButtonVariant } from "primitives.slint";
import { PageHeader } from "page-parts.slint";
import { TrackTable } from "track-table.slint";
import { Nav, Route } from "nav.slint";
import { Data, Player } from "stores.slint";

export component TopDetailPage inherits Rectangle {

    VerticalLayout {
        y: Theme.space-4;
        height: parent.height - 2 * Theme.space-4;
        width: parent.width - 2 * Theme.space-4;
        x: Theme.space-4;
        spacing: Theme.space-4;

        PageHeader {
            title: Data.top-detail-found ? Data.top-detail-name : "排行榜详情";
            show-back: Nav.can-go-back;
            back => {
                Nav.back();
            }
            meta-items: [
                Data.top-detail-found ? Data.top-detail-total + " 首" : "",
                Data.top-detail-found && Data.top-detail-update != ""
                    ? "更新 " + Data.top-detail-update : "",
            ];
        }

        if Data.top-detail-state == 0 || Data.top-detail-state == 1: Rectangle {
            height: 160px;

            Text {
                width: parent.width;
                y: 64px;
                text: Data.top-detail-state == 1 ? "正在加载榜单详情…" : "即将加载…";
                color: Theme.muted-foreground;
                font-size: 14px;
                horizontal-alignment: center;
            }
        }

        if Data.top-detail-state == 4: Rectangle {
            height: 160px;

            Text {
                width: parent.width;
                y: 64px;
                text: "加载失败（离线或网络异常）";
                color: Theme.muted-foreground;
                font-size: 14px;
                horizontal-alignment: center;
            }
        }

        if Data.top-detail-state == 2 && Data.top-detail-tracks.length > 0: Rectangle {
            height: parent.height - 64px;

            HorizontalLayout {
                Button {
                    text: "播放全部";
                    variant: ButtonVariant.default;
                    width: 96px;
                    clicked => {
                        Player.play-tracks(Data.top-detail-tracks, 0);
                    }
                }
            }

            TrackTable {
                y: 44px;
                width: parent.width;
                height: parent.height - 44px;
                tracks: Data.top-detail-tracks;
                show-album: true;
                show-duration: true;
            }
        }
    }
}
