// 竖向音量（VolumeControl.vue，DESIGN.md v0.2/v0.11）：
// 静息只有图标；hover 弹出上方细长窄条（宽 44px，数值 + 4px 细轨），
// 离开图标与面板 180ms 后自动收起（宽限跨过与图标的 10px 缝隙）。
// 图标点击 = 静音切换（volume_up / volume_off 资产切换）；拖拽为直接指针跟随。
// 悬浮层用组件内 overlay 而非 PopupWindow：hover 状态需同组件直读，
// 且 PlayerBar 无裁剪，负 y 覆盖内容区绘制正常。
import { Theme } from "theme.slint";
import { Icons } from "icons.slint";
import { AppIcon, EqClock } from "primitives.slint";
import { Player, TrackPalette } from "stores.slint";

export component VolumeControl inherits Rectangle {
    width: 36px;
    height: 36px;
    border-radius: Theme.pill(self.height);
    background: icon-touch.has-hover ? Theme.muted : transparent;
    animate background {
        duration: Theme.duration-fast;
        easing: cubic-bezier(0.2, 0, 0, 1);
    }

    // 静音记忆：非零音量时记录，静音后恢复（init 快照 + 点击时更新，避免自引用绑定环）
    property <bool> muted: Player.volume <= 0.01;
    property <float> last-volume: 1.0;
    init => {
        last-volume = Player.volume > 0.01 ? Player.volume : 1.0;
    }

    // —— hover 悬浮层：图标/面板任一 hover 即开；全离开后宽限 180ms 再收
    // （跨过图标与面板间 10px 缝隙；事件分帧派发时的瞬时双 false 也被宽限吸收）。
    // 收起用 EqClock 截止时刻而非 Timer：时钟常跑（33ms 粒度），声明式绑定
    // 不依赖定时器重启，testing backend 与真机行为一致。———
    property <bool> pop-hover:
        icon-touch.has-hover || pop-cover.has-hover || vol-touch.has-hover;
    property <duration> leave-at: 0ms;
    property <bool> pop-open:
        self.pop-hover || (self.leave-at != 0ms && EqClock.t - self.leave-at < 180ms);
    changed pop-hover => {
        self.leave-at = self.pop-hover ? 0ms : EqClock.t;
    }

    // —— 滚轮调音量：上滚 +0.05 / 下滚 −0.05（clamp 0..1），accept 防止冒泡
    // 滚动页面。set-volume 在 Rust 侧立即本地回显 + 500ms daemon 回写抑制窗
    // （player_bridge.rs on_set_volume），手感即时且不与推送打架；弹层打开时
    // 在面板/滑轨上滚动同样生效。———
    function wheel-volume(delta-y: length) -> EventResult {
        Player.set-volume(clamp(Player.volume + (delta-y > 0 ? 0.05 : -0.05), 0.0, 1.0));
        return accept;
    }

    icon-touch := TouchArea {
        mouse-cursor: pointer;
        clicked => {
            if (muted) {
                Player.set-volume(last-volume > 0.01 ? last-volume : 1.0);
            } else {
                last-volume = Player.volume;
                Player.set-volume(0.0);
            }
        }
        scroll-event(event) => {
            return root.wheel-volume(event.delta-y);
        }
    }

    AppIcon {
        source: muted ? Icons.volume_off : Icons.volume_up;
        icon-color: Theme.foreground;
        width: 21px;
        height: 21px;
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
    }

    // —— 悬浮面板（图标上方 10px，宽 44 值 208 高）———
    volume-pop := Rectangle {
        visible: root.pop-open;
        opacity: root.pop-open ? 1 : 0;
        animate opacity {
            duration: Theme.duration-fast;
            easing: cubic-bezier(0.2, 0, 0, 1);
        }
        x: (parent.width - self.width) / 2;
        y: -self.height - 10px;
        width: 44px;
        height: 208px;

        Rectangle {
            width: parent.width;
            height: parent.height;
            border-radius: Theme.radius-lg;
            background: Theme.surface-3;
            drop-shadow-blur: 12px;
            drop-shadow-color: #241F1B.transparentize(0.82);
            drop-shadow-offset-y: 4px;

            // 垫底 hover 传感：接住面板空白区（滑块 TouchArea 在上层优先命中）
            pop-cover := TouchArea {
                scroll-event(event) => {
                    return root.wheel-volume(event.delta-y);
                }
            }

            VerticalLayout {
                padding-top: 10px;
                padding-bottom: 12px;
                spacing: 6px;

                Text {
                    height: 16px;
                    text: "\{Math.round(Player.volume * 100)}";
                    color: Theme.foreground;
                    font-size: 11px;
                    horizontal-alignment: center;
                }

                // 细轨：4px 竖轨 + 12px thumb，整列命中放宽拖拽
                Rectangle {
                    horizontal-stretch: 1;

                    Rectangle {
                        width: 4px;
                        x: (parent.width - self.width) / 2;
                        y: 0;
                        height: parent.height;
                        border-radius: 2px;
                        background: Theme.track;

                        Rectangle {
                            x: 0;
                            y: (1 - Player.volume) * parent.height;
                            width: parent.width;
                            height: parent.height - self.y;
                            border-radius: 2px;
                            background: TrackPalette.ctx-accent;
                        }
                    }

                    // thumb 纯视觉；拖拽命中区为整列
                    Rectangle {
                        width: 12px;
                        height: 12px;
                        border-radius: Theme.pill(self.height);
                        background: Theme.surface-3;
                        border-width: 2px;
                        border-color: TrackPalette.ctx-accent;
                        x: (parent.width - self.width) / 2;
                        y: clamp((1 - Player.volume) * parent.height - self.height / 2, 0px, parent.height - self.height);
                    }

                    vol-touch := TouchArea {
                        pointer-event(event) => {
                            if (event.kind == PointerEventKind.down) {
                                Player.set-volume(1.0 - clamp(self.mouse-y / self.height, 0.0, 1.0));
                            }
                        }
                        moved => {
                            Player.set-volume(1.0 - clamp(self.mouse-y / self.height, 0.0, 1.0));
                        }
                        scroll-event(event) => {
                            return root.wheel-volume(event.delta-y);
                        }
                    }
                }
            }
        }
    }
}
