// 侧栏（Sidebar.vue，v0.8 单一滑块 + v0.12 歌单区宽窄双形态）：
// 整条侧栏滚动区共用一个 HoverGroup 滑动高亮块；"我的歌单"纯标题从块下穿过。
// 宽侧栏 = 分组折叠（chevron 旋转 + 高度过渡）；窄边栏 = 两级滑动导航。
import { Theme } from "theme.slint";
import { Icons } from "icons.slint";
import { AppIcon, Button, HoverGroup, HoverItem, Scroll } from "primitives.slint";
import { Nav, Route } from "nav.slint";
import { PlaylistCover } from "data.slint";
import { Data } from "stores.slint";

// 页脚图标钮（收起/设置/主题三钮共用规格；横竖两形态容器各自取用）
component FooterButton inherits Button {
    in property <image> glyph;
    in property <string> tip;
    icon: glyph;
    icon-only: true;
    icon-size: 20px;
    tool-tip: tip;
    width: 36px;
    height: 36px;
}

export component Sidebar inherits Rectangle {
    /** 窄窗图标栏形态（MainLayout 计算：手动切换优先，跨断点回自动） */
    in property <bool> collapsed: false;
    callback toggle-collapsed();

    background: transparent;
    clip: true;

    // —— 我的歌单（真歌单经 Data 装载；色对为 Rust 侧确定性装饰）———
    // 宽侧栏分组折叠状态
    property <bool> created-open: true;
    property <bool> favorited-open: true;
    // 窄边栏两级滑动：-1=一级入口，否则进入对应分组二级（0=自建 1=收藏）
    property <int> active-group: -1;
    /** 退出动画期间仍展示原分组：记住最后进入的分组 */
    property <int> last-group: 0;

    function nav-active(target: Route, exact: bool) -> bool {
        if (exact) {
            return Nav.route == target;
        }
        // 前缀语义：只有"排行榜"有子路由（详情页）
        return Nav.route == target || (target == Route.top && Nav.route == Route.top-detail);
    }

    VerticalLayout {
        // —— 账户面板（窄边栏隐藏）———
        HorizontalLayout {
            height: collapsed ? 0px : 52px;
            padding: 8px;
            spacing: Theme.space-4;
            visible: !collapsed;

            Rectangle {
                width: 38px;
                height: 38px;
                border-radius: Theme.radius-sm;
                background: Theme.muted;

                AppIcon {
                    source: Icons.account_circle;
                    icon-color: Theme.primary;
                    width: 21.6px;
                    height: 21.6px;
                    x: (parent.width - self.width) / 2;
                    y: (parent.height - self.height) / 2;
                }
            }

            VerticalLayout {
                horizontal-stretch: 1;
                alignment: LayoutAlignment.center;
                spacing: 1px;

                Text {
                    text: Data.account-state == 0 ? "读取账号状态中…"
                        : Data.account-logged-in ? Data.account-nickname
                        : "未登录";
                    color: Theme.foreground;
                    font-size: 15.2px;
                    font-weight: 600;
                    overflow: elide;
                }
                Text {
                    text: !Data.account-logged-in ? "登录后同步云端歌单与收藏"
                        : Data.account-vip == "" ? "QQ 音乐已登录"
                        : Data.account-vip;
                    color: Theme.muted-foreground;
                    font-size: 12px;
                    overflow: elide;
                }
            }

            // 登出仅在已登录时出现；点击走 Data.logout（bridge → daemon Logout IPC）
            if Data.account-logged-in: Button {
                icon: Icons.logout;
                icon-only: true;
                icon-size: 20px;
                tool-tip: "退出登录";
                width: 40px;
                height: 40px;
                clicked => {
                    Data.logout();
                }
            }
        }

        // —— 滚动导航区：整条单一滑动高亮 ———
        // 命名供歌单区行窗读滚动状态（窗口化虚拟化，模式同 track-table）
        nav-scroll := Scroll {
            vertical-stretch: 1;

            // 整条侧栏单一滑块（Vue 同构）；行是 Button → 块复制 radius-md
            hg := HoverGroup {
                highlight-color: Theme.neutral-300;
                item-radius: Theme.radius-md;
                highlight-opacity: 0.6;

                VerticalLayout {
                    spacing: 4px;

                    // —— 主导航 ———
                    for item in [
                        {label: "首页", icon: Icons.home, target: Route.home, exact: true},
                        {label: "发现", icon: Icons.explore, target: Route.discover, exact: false},
                        {label: "排行榜", icon: Icons.leaderboard, target: Route.top, exact: false},
                        {label: "搜索", icon: Icons.search, target: Route.search, exact: true},
                        {label: "我喜欢", icon: Icons.favorite_outline, target: Route.library, exact: true},
                        {label: "最近播放", icon: Icons.history, target: Route.recent, exact: false},
                        {label: "音乐库", icon: Icons.library_music, target: Route.local, exact: false},
                        {label: "下载", icon: Icons.download, target: Route.downloads, exact: false},
                        {label: "已购音乐", icon: Icons.shopping_bag, target: Route.purchased, exact: false},
                    ]: HoverItem {
                        group-id: hg.group-id;
                        height: 40px;

                        Button {
                            icon: item.icon;
                            text: collapsed ? "" : item.label;
                            icon-only: collapsed;
                            icon-size: 21.6px;
                            current: root.nav-active(item.target, item.exact);
                            suppress-hover: true;
                            width: parent.width;
                            height: 40px;
                            tool-tip: collapsed ? item.label : "";
                            clicked => {
                                Nav.navigate(item.target, "");
                            }
                        }
                    }

                    // —— 我的歌单区 ———
                    Rectangle {
                        height: 26px;
                        visible: !collapsed;

                        Text {
                            x: 12px;
                            y: 0;
                            text: "我的歌单";
                            color: Theme.muted-foreground;
                            font-size: 13.6px;
                            vertical-alignment: center;
                        }
                    }

                    // 宽侧栏：分组折叠
                    if !collapsed: VerticalLayout {
                        spacing: 8px;

                        for group in [
                            {title: "自建歌单", icon: Icons.playlist_play, group: 0},
                            {title: "收藏歌单", icon: Icons.bookmark, group: 1},
                        ]: VerticalLayout {
                            spacing: 0px;

                            HoverItem {
                                group-id: hg.group-id;
                                height: 40px;

                                HorizontalLayout {
                                    spacing: 4px;

                                    Button {
                                        icon: group.icon;
                                        text: group.title;
                                        icon-size: 21.6px;
                                        suppress-hover: true;
                                        // 收藏组无新建键：主按钮补位让 chevron 贴右缘
                                        width: parent.width - (group.group == 0 ? 76px : 38px);
                                        height: 40px;
                                        clicked => {
                                            root.toggle-group(group.group);
                                        }
                                    }

                                    // 新建（仅自建组有，mock 期无动作）：行 hover 底归
                                    // HoverGroup 滑块，本钮 hover 走本体提色
                                    if group.group == 0: Button {
                                        icon: Icons.add;
                                        icon-only: true;
                                        icon-size: 18px;
                                        tool-tip: "新建歌单";
                                        suppress-hover: true;
                                        hover-tint: true;
                                        width: 34px;
                                        height: 40px;
                                    }

                                    // 展开/收起：chevron 随态旋转 -90°；hover 本体提色（同 + 钮）
                                    Rectangle {
                                        width: 34px;
                                        height: 40px;

                                        chev-touch := TouchArea {
                                            mouse-cursor: pointer;
                                            clicked => {
                                                root.toggle-group(group.group);
                                            }
                                        }
                                        AppIcon {
                                            source: Icons.expand_more;
                                            icon-color: chev-touch.has-hover ? Theme.foreground : Theme.muted-foreground;
                                            width: 18px;
                                            height: 18px;
                                            rotation-angle: root.group-open(group.group) ? 0deg : -90deg;
                                            x: (parent.width - self.width) / 2;
                                            y: (parent.height - self.height) / 2;
                                            animate icon-color {
                                                duration: Theme.duration-fast;
                                                easing: cubic-bezier(0.2, 0, 0, 1);
                                            }
                                        }
                                    }
                                }
                            }

                            // 组内条目：高度过渡（展开/收起）
                            Rectangle {
                                clip: true;
                                height: root.group-open(group.group) ? items-col.preferred-height : 0px;
                                animate height {
                                    duration: Theme.duration-normal;
                                    easing: cubic-bezier(0.2, 0, 0, 1);
                                }

                                items-col := VerticalLayout {
                                    padding-top: 4px;
                                    padding-bottom: 4px;
                                    padding-left: 24px;

                                    // —— 行窗口容器（窗口化虚拟化，模式同 track-table
                                    // MEMFIX ④a）——— 歌单数据无上限（QQ 收藏歌单可达
                                    // 数百），全量实例化既卡又费纹理。高度 = N×行距只
                                    // 依赖模型长度：组收起动画读 items-col.preferred-height，
                                    // 数值与全量渲染完全一致，故不做 group-open 门控
                                    // （收起期间行必须保持实例化，否则收起动画闪空；
                                    // 收起态窗口化已把驻留行数压到约一屏 + overscan）。
                                    // 滚动源 = 本文件 nav-scroll 命名引用，无需 Viewport
                                    // 全局（那只服务顶层页面滚动）。依赖链单向：窗口量
                                    // 只依赖滚动状态与 N，绝不反向掺入（否则与滚动偏移
                                    // 绑定成环）。
                                    Rectangle {
                                        property <int> n: root.playlists-of(group.group).length;
                                        // 容器顶在内容系 y：absolute-position 是窗口系
                                        // 且含滚动偏移（活依赖），减 scroll 原点与
                                        // scroll-offset 恰好抵消滚动位移——恒定内容坐标
                                        property <length> list-top: self.absolute-position.y
                                            - nav-scroll.absolute-position.y - nav-scroll.scroll-offset;
                                        property <int> window-start: nav-scroll.view-height <= 0px ? 0
                                            : clamp(
                                                Math.floor((-nav-scroll.scroll-offset - list-top) / 36px) - 8,
                                                0,
                                                Math.max(n - 1, 0),
                                            );
                                        property <int> window-count: nav-scroll.view-height <= 0px ? n
                                            : Math.min(n - window-start,
                                                Math.ceil(nav-scroll.view-height / 36px) + 16);

                                        height: n * 36px;

                                        // 行按绝对索引绝对定位；offset 只是窗口内序号，
                                        // 取数/跳转一律经 abs-index 换算回整表下标
                                        for offset in window-count: HoverItem {
                                            property <int> abs-index: parent.window-start + offset;
                                            property <PlaylistCover> rowd: root.playlists-of(group.group)[abs-index];
                                            group-id: hg.group-id;
                                            x: 0;
                                            y: abs-index * 36px;
                                            width: parent.width;
                                            height: 36px;
                                            // 行点击进歌单详情（参数与库页歌单卡同一 id 串）
                                            clicked => {
                                                Nav.navigate(Route.playlist, rowd.id);
                                            }

                                            HorizontalLayout {
                                                padding-left: 8px;
                                                padding-right: 8px;
                                                spacing: 8px;
                                                alignment: LayoutAlignment.start;

                                                Rectangle {
                                                    width: 28px;
                                                    height: 28px;
                                                    border-radius: Theme.radius-sm;
                                                    // 圆角只裁自身背景，不裁子 Image：不 clip 则
                                                    // 图片以直角溢出圆角（与 queue-drawer 缩略图同款）
                                                    clip: true;
                                                    background: Theme.muted;
                                                    y: (parent.height - self.height) / 2;
                                                    Image {
                                                        source: rowd.image;
                                                        width: parent.width;
                                                        height: parent.height;
                                                        image-fit: ImageFit.cover;
                                                    }
                                                }
                                                Text {
                                                    text: rowd.name;
                                                    color: Theme.muted-foreground;
                                                    font-size: 12.8px;
                                                    vertical-alignment: center;
                                                    overflow: elide;
                                                    horizontal-stretch: 1;
                                                }
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    }

                    // 窄边栏：两级滑动导航（高度不参与过渡：激活 pane 撑高，非激活平移出视口）
                    if collapsed: playlist-slider := Rectangle {
                        height: active-group == -1 ? slider-entries.preferred-height : slider-list.preferred-height;
                        clip: true;

                        // 一级：分组入口行
                        slider-entries := VerticalLayout {
                            x: active-group == -1 ? 0px : -self.width;
                            width: parent.width;
                            animate x {
                                duration: Theme.duration-normal;
                                easing: cubic-bezier(0.2, 0, 0, 1);
                            }

                            for entry in [
                                {label: "自建歌单", icon: Icons.playlist_play, group: 0},
                                {label: "收藏歌单", icon: Icons.bookmark, group: 1},
                            ]: HoverItem {
                                group-id: hg.group-id;
                                height: 40px;

                                Button {
                                    icon: entry.icon;
                                    icon-only: true;
                                    icon-size: 21.6px;
                                    suppress-hover: true;
                                    width: parent.width;
                                    height: 40px;
                                    tool-tip: entry.label;
                                    clicked => {
                                        last-group = entry.group;
                                        active-group = entry.group;
                                    }
                                }
                            }
                        }

                        // 二级：返回 + 纯封面列表（与主导航行同规格，滑块几何一致）
                        slider-list := VerticalLayout {
                            x: active-group == -1 ? self.width : 0px;
                            width: parent.width;
                            animate x {
                                duration: Theme.duration-normal;
                                easing: cubic-bezier(0.2, 0, 0, 1);
                            }

                            HoverItem {
                                group-id: hg.group-id;
                                height: 40px;

                                Button {
                                    icon: Icons.arrow_back;
                                    icon-only: true;
                                    icon-size: 21.6px;
                                    suppress-hover: true;
                                    width: parent.width;
                                    height: 40px;
                                    tool-tip: "返回歌单分组";
                                    clicked => {
                                        active-group = -1;
                                    }
                                }
                            }

                            // —— 封面行窗口容器（窗口化虚拟化，同宽侧栏组内行窗）———
                            // slider-list 的 preferred-height 随钉死容器高度自然撑高，
                            // 外层 playlist-slider 的高度切换语义不变
                            Rectangle {
                                property <int> n: root.slider-covers().length;
                                property <length> list-top: self.absolute-position.y
                                    - nav-scroll.absolute-position.y - nav-scroll.scroll-offset;
                                property <int> window-start: nav-scroll.view-height <= 0px ? 0
                                    : clamp(
                                        Math.floor((-nav-scroll.scroll-offset - list-top) / 40px) - 8,
                                        0,
                                        Math.max(n - 1, 0),
                                    );
                                property <int> window-count: nav-scroll.view-height <= 0px ? n
                                    : Math.min(n - window-start,
                                        Math.ceil(nav-scroll.view-height / 40px) + 16);

                                height: n * 40px;

                                for offset in window-count: HoverItem {
                                    property <int> abs-index: parent.window-start + offset;
                                    property <PlaylistCover> rowd: root.slider-covers()[abs-index];
                                    group-id: hg.group-id;
                                    x: 0;
                                    y: abs-index * 40px;
                                    width: parent.width;
                                    height: 40px;

                                    Button {
                                        icon-only: true;
                                        suppress-hover: true;
                                        width: parent.width;
                                        height: 40px;
                                        tool-tip: rowd.name;
                                        // 按钮铺满行、接管点击：跳转挂按钮（hover 归 HoverItem 不变）
                                        clicked => {
                                            Nav.navigate(Route.playlist, rowd.id);
                                        }

                                        Rectangle {
                                            width: 28px;
                                            height: 28px;
                                            border-radius: Theme.radius-sm;
                                            clip: true;
                                            background: Theme.muted;
                                            x: (parent.width - self.width) / 2;
                                            y: (parent.height - self.height) / 2;
                                            Image {
                                                source: rowd.image;
                                                width: parent.width;
                                                height: parent.height;
                                                image-fit: ImageFit.cover;
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }

        // —— 页脚：收起 / 设置 / 主题循环 ———
        // 窄栏（64px）横排放不下三个 36px 钮，收起态竖排居中（Vue 基准
        // .sidebar.is-collapsed .sidebar-footer 同款 flex-direction: column）
        if collapsed: VerticalLayout {
            height: 140px;
            padding: 8px;
            spacing: 8px;
            cross-axis-alignment: center;

            FooterButton {
                glyph: Icons.left_panel_close;
                tip: "展开侧栏";
                clicked => {
                    root.toggle-collapsed();
                }
            }

            FooterButton {
                glyph: Icons.settings;
                tip: "设置";
                clicked => {
                    Nav.navigate(Route.settings, "");
                }
            }

            FooterButton {
                glyph: Theme.mode == 2 ? Icons.dark_mode : Theme.mode == 1 ? Icons.light_mode : Icons.brightness_auto;
                tip: Theme.mode == 2 ? "主题（当前：深色，点击切换）"
                    : Theme.mode == 1 ? "主题（当前：浅色，点击切换）"
                    : "主题（当前：跟随系统，点击切换）";
                clicked => {
                    Theme.cycle-mode();
                }
            }
        }

        if !collapsed: HorizontalLayout {
            height: 52px;
            padding: 8px;
            spacing: 8px;
            alignment: LayoutAlignment.end;

            FooterButton {
                glyph: Icons.left_panel_close;
                tip: "收起侧栏";
                clicked => {
                    root.toggle-collapsed();
                }
            }

            FooterButton {
                glyph: Icons.settings;
                tip: "设置";
                clicked => {
                    Nav.navigate(Route.settings, "");
                }
            }

            FooterButton {
                glyph: Theme.mode == 2 ? Icons.dark_mode : Theme.mode == 1 ? Icons.light_mode : Icons.brightness_auto;
                tip: Theme.mode == 2 ? "主题（当前：深色，点击切换）"
                    : Theme.mode == 1 ? "主题（当前：浅色，点击切换）"
                    : "主题（当前：跟随系统，点击切换）";
                clicked => {
                    Theme.cycle-mode();
                }
            }
        }
    }

    // —— 分组状态辅助 ———
    public pure function group-open(group: int) -> bool {
        return group == 0 ? created-open : favorited-open;
    }

    public function toggle-group(group: int) {
        if (group == 0) {
            created-open = !created-open;
        } else {
            favorited-open = !favorited-open;
        }
    }

    public pure function slider-covers() -> [PlaylistCover] {
        return last-group == 0 ? Data.sidebar-created : Data.sidebar-favorited;
    }

    public pure function playlists-of(group: int) -> [PlaylistCover] {
        return group == 0 ? Data.sidebar-created : Data.sidebar-favorited;
    }
}

