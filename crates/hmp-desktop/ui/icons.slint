// 图标资产注册表（assets/icons/*.svg，与 Vue 版同源 Material 风格）。
// 消费经 AppIcon 的 colorize 着色（SVG 全部 fill=currentColor）。

export global Icons {
    out property <image> account_circle: @image-url("assets/icons/account-circle-rounded.svg");
    out property <image> add: @image-url("assets/icons/add-rounded.svg");
    out property <image> album: @image-url("assets/icons/album-rounded.svg");
    out property <image> arrow_back: @image-url("assets/icons/arrow-back-rounded.svg");
    out property <image> bookmark: @image-url("assets/icons/bookmark-rounded.svg");
    // 资产库没有 check，QualityBadge 弹层用（Vue 版同款内联 SVG，12px 勾）
