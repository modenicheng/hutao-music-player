    out property <image> history: @image-url("assets/icons/history-rounded.svg");
    out property <image> home: @image-url("assets/icons/home-rounded.svg");
    out property <image> leaderboard: @image-url("assets/icons/leaderboard-rounded.svg");
    out property <image> left_panel_close: @image-url("assets/icons/left-panel-close-rounded.svg");
