// 自绘标题栏（无边框窗口壳；桌面端新增——Vue 版跑在浏览器里没有对应物）：
// 左侧窗口标题 + 右侧 Windows 风格最小化/最大化(还原)/关闭钮；
// 沉浸态（播放页 overlay）最左侧渲染收起键（关闭折角并入标题栏带）；
// 空白区按住拖动移窗、双击切换最大化（Windows 惯例）。
//
// 拖动本体走 WinChrome.drag()：Slint 语言层没有窗口移动原语（1.17 已无
// WindowDragArea），由 Rust 经 winit 句柄发起系统级移动循环——拖到屏缘
// 的贴靠/半屏分列也由系统原生处理；testing/非 winit 后端未接线时空操作。
import { Theme } from "theme.slint";
import { Icons } from "icons.slint";
import { AppIcon } from "primitives.slint";
// 曲目层前景色（收起键随专辑环境对比度取色；stores 无反向依赖，无循环导入）
import { TrackPalette } from "stores.slint";

/** Rust 侧接线的窗口操作桥（main.rs：WinitWindowAccessor::with_winit_window） */
export global WinChrome {
    /** 发起系统级窗口移动（按住顶栏位移超阈值时调用一次） */
    callback drag();
}

// Windows 标题栏钮：46×32（关闭钮加宽到 48 好点按），glyph 10×10、1px 线；
// hover 满高底色（关闭钮 Win11 红 #C42B1C + glyph 转白），无圆角无过渡。
component CaptionButton inherits Rectangle {
    /** 关闭钮标记：hover 红底白 glyph */
    in property <bool> danger;
    /** glyph 路径（viewbox 10×10，坐标带 0.5 偏移让 1px 线落在像素网格上） */
    in property <string> glyph;
    callback clicked;

    width: danger ? 48px : 46px;
    background: btn.has-hover
        ? (danger ? #C42B1C : Theme.foreground.transparentize(0.93))
        : transparent;

    btn := TouchArea {
        clicked => {
            root.clicked();
        }
    }

    Path {
        width: 10px;
        height: 10px;
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        viewbox-width: 10;
        viewbox-height: 10;
        commands: root.glyph;
        stroke: root.danger && btn.has-hover ? #FFFFFF : Theme.foreground;
        stroke-width: 1px;
        fill: transparent;
    }
}

export component TitleBar inherits Rectangle {
    /** 当前最大化态（AppWindow 从 root.window.maximized 单向喂入，驱动 glyph 切换） */
    in property <bool> maximized: false;
    /** 沉浸态（播放页 overlay 覆盖全窗时）：隐藏左侧标题文字，窗口钮/拖拽保留 */
    in property <bool> immersive: false;
    /** 沉浸态渲染最左侧收起键（播放页 overlay 的关闭折角并入标题栏带，
        与窗口钮同一水平带；非沉浸态不渲染、拖拽区几何与常态完全一致） */
    in property <bool> show-collapse: false;
    callback minimize-request();
    callback toggle-maximize-request();
    callback close-request();
    /** 收起键点击（app.slint 接 Player.hide-overlay） */
    callback collapse-request();

    height: Theme.title-bar-height;
    background: transparent;

    // 窗口标题（Windows 惯例在左；没有小尺寸品牌图标资产，只放文字）
    Text {
        x: Theme.space-3;
        y: (parent.height - self.height) / 2;
        text: "胡桃音乐";
        font-size: 12px;
        color: Theme.muted-foreground;
        visible: !root.immersive;
    }

    // 拖拽/双击命中区（右侧按钮列除外；show-collapse 时让开最左收起键）。
    // 阈值起拖：4px 内的纯点击不打扰双击判定；起拖后系统的 SC_MOVE 模态
    // 循环会吞掉 release，TouchArea 卡在按住态——下次按下 pointer-event(down)
    // 重置 drag-armed 即恢复。
    title-hit := TouchArea {
        x: root.show-collapse ? 40px : 0;
        y: 0;
        width: parent.width - caption-row.width - self.x;
        height: parent.height;
        property <bool> drag-armed: false;
        pointer-event(event) => {
            if (event.kind == PointerEventKind.down) {
                drag-armed = false;
            }
        }
        moved => {
            if (!drag-armed
                && (Math.abs(self.mouse-x - self.pressed-x) > 4px
                    || Math.abs(self.mouse-y - self.pressed-y) > 4px)) {
                drag-armed = true;
                WinChrome.drag();
            }
        }
        double-clicked => {
            root.toggle-maximize-request();
        }
    }

    // 收起键（仅 show-collapse 渲染；条件实例保证非沉浸态零命中区）：
    // 命中区 40×32 与窗口钮同带（x:0 顶满，flush 语言）；裸 chevron 向下
    // 20px 居中，glyph 中心 y=16px 与窗口钮精确同线。历史上这枚键长在
    // now-playing 里、整体让开标题栏带而"偏下"——TitleBar 本就压在 overlay
    // 与队列抽屉最顶，层级问题层级解法，键并入标题栏带。
    if root.show-collapse: TouchArea {
        x: 0;
        y: 0;
        width: 40px;
        height: parent.height;
        mouse-cursor: pointer;
        clicked => {
            root.collapse-request();
        }
        AppIcon {
            source: Icons.expand_more;
            icon-color: parent.has-hover
                ? TrackPalette.on-ambient
                : TrackPalette.on-ambient.transparentize(0.25);
            animate icon-color {
                duration: Theme.duration-fast;
                easing: cubic-bezier(0.2, 0, 0, 1);
            }
            width: 20px;
            height: 20px;
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
        }
    }

    caption-row := Rectangle {
        x: parent.width - self.width;
        y: 0;
        width: 140px; // 46 + 46 + 48
        height: parent.height;

        CaptionButton {
            x: 0px;
            height: parent.height;
            glyph: "M 0 5 L 10 5";
            clicked => {
                root.minimize-request();
            }
        }

        CaptionButton {
            x: 46px;
            height: parent.height;
            glyph: root.maximized
                ? "M 0.5 2.5 L 7.5 2.5 L 7.5 9.5 L 0.5 9.5 Z M 2.5 2.5 L 2.5 0.5 L 9.5 0.5 L 9.5 7.5 L 7.5 7.5"
                : "M 0.5 0.5 L 9.5 0.5 L 9.5 9.5 L 0.5 9.5 Z";
            clicked => {
                root.toggle-maximize-request();
            }
        }

        CaptionButton {
            x: 92px;
            height: parent.height;
            danger: true;
            glyph: "M 0.5 0.5 L 9.5 9.5 M 9.5 0.5 L 0.5 9.5";
            clicked => {
                root.close-request();
            }
        }
    }
}
