// 我喜欢（LibraryView.vue，v0.6/v0.13）：页头元信息 → 我喜欢 hero 卡（中性表面卡
// + 心形渐变封面，播放全部）→ 喜欢列表 → 最近播放预览 → 创建/收藏歌单网格。
import { Theme } from "theme.slint";
import { Icons } from "icons.slint";
import { AppIcon, Button, ButtonVariant } from "primitives.slint";
import { CoverCard, PageHeader, SectionHeader } from "page-parts.slint";
import { TrackTable } from "track-table.slint";
import { Nav, Route } from "nav.slint";
import { Data, Player } from "stores.slint";

export component LibraryPage inherits Rectangle {
    background: transparent;

    VerticalLayout {
        padding-top: Theme.space-6;
        padding-left: Theme.space-8;
        padding-right: Theme.space-8;
        padding-bottom: Theme.space-10;
        spacing: Theme.space-4;

        PageHeader {
            title: "我喜欢";
            meta-items: [
                "\{Data.liked-count} 首喜欢的歌",
                "\{Data.playlist-count} 个歌单",
            ];
        }

        // —— 我喜欢 hero 卡 ——
        Rectangle {
            border-radius: Theme.radius-lg;
            background: Theme.surface-3;
            drop-shadow-blur: 2px;
            drop-shadow-color: #241F1B.transparentize(0.92);
            drop-shadow-offset-y: 1px;

            HorizontalLayout {
                padding-left: Theme.space-5;
                padding-right: Theme.space-5;
                padding-top: Theme.space-4;
                padding-bottom: Theme.space-4;
                spacing: Theme.space-4;

                // 与侧栏"喜欢的收藏"封面同一渐变，保持身份一致
                Rectangle {
                    width: 72px;
                    height: 72px;
                    border-radius: Theme.radius-md;
                    background: @linear-gradient(135deg, #7660a4, #ef9d9d);
                    drop-shadow-blur: 2px;
                    drop-shadow-color: #241F1B.transparentize(0.92);
                    drop-shadow-offset-y: 1px;

                    AppIcon {
                        source: Icons.favorite_filled;
                        icon-color: Theme.surface-3;
                        width: 25.6px;
                        height: 25.6px;
                        x: (parent.width - self.width) / 2;
                        y: (parent.height - self.height) / 2;
                    }
                }

                VerticalLayout {
                    horizontal-stretch: 1;
                    alignment: LayoutAlignment.center;
                    spacing: 2px;

                    Text {
                        text: "我喜欢";
                        color: Theme.muted-foreground;
                        font-size: 12.5px;
                        font-weight: 600;
                    }
                    Text {
                        text: "私藏的心动瞬间";
                        color: Theme.foreground;
                        font-size: 18.4px;
                        font-weight: 650;
                    }
                    Text {
                        text: "\{Data.liked-count} 首";
                        color: Theme.muted-foreground;
                        font-size: 13px;
                    }
                }

                if Data.liked-count > 0: Button {
                    variant: ButtonVariant.default;
                    small: true;
                    icon: Icons.play_arrow;
                    icon-size: 17.6px;
                    text: "播放全部";
                    height: 32px;
                    y: (parent.height - self.height) / 2;
                    clicked => {
                        Player.play-tracks(Data.liked, 0);
                    }
                }
            }
        }

        // —— 喜欢列表 ——
        TrackTable {
            tracks: Data.liked;
            show-header: true;
        }

        // —— 最近播放预览（整页入口在最近播放页）——
        VerticalLayout {
            spacing: Theme.space-4;

            SectionHeader {
                title: "最近播放";
                more-to: "recent";
                more-clicked => {
                    Nav.navigate(Route.recent, "");
                }
            }
            TrackTable {
                tracks: Data.recent-preview;
                show-header: true;
            }
        }

        // —— 创建的歌单 ——
        VerticalLayout {
            spacing: Theme.space-4;

            SectionHeader {
                title: "创建的歌单";
            }
            playlist-grid := HorizontalLayout {
                spacing: Theme.space-4;

                for card in Data.created-playlists: CoverCard {
                    width: Theme.grid-card-width(playlist-grid.width);
                    cover: card.cover;
                    title: card.title;
                    subtitle: card.subtitle;
                    clicked => {
                        Nav.navigate(Route.playlist, card.mid);
                    }
                }
            }
        }

        // —— 收藏的歌单 ——
        VerticalLayout {
            spacing: Theme.space-4;

            SectionHeader {
                title: "收藏的歌单";
            }
            fav-grid := HorizontalLayout {
                spacing: Theme.space-4;

                for card in Data.favorited-playlists: CoverCard {
                    width: Theme.grid-card-width(fav-grid.width);
                    cover: card.cover;
                    title: card.title;
                    subtitle: card.subtitle;
                    clicked => {
                        Nav.navigate(Route.playlist, card.mid);
                    }
                }
            }
        }
    }
}
