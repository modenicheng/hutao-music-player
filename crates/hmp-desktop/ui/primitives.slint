// 基元组件（对应 hmp-tauri/src/components 的 Button / AppIcon / Equalizer /
// HoverGroup / Scroll 等，DESIGN.md §3.0 通用件）。
import { Theme } from "theme.slint";
import { Icons } from "icons.slint";

// ——— AppIcon：SVG 资产 + colorize 着色（currentColor 对应物）———
export component AppIcon inherits Rectangle {
    in property <image> source;
    in property <color> icon-color: Theme.foreground;
    /** 旋转角，用于 chevron 随展开态旋转等 */
    in property <angle> rotation-angle: 0deg;
    background: transparent;

    Image {
        x: 0;
        y: 0;
        width: parent.width;
        height: parent.height;
        source: root.source;
        colorize: root.icon-color;
        transform-rotation: root.rotation-angle;
        transform-origin: { x: self.width / 2, y: self.height / 2 };
        animate transform-rotation {
            duration: Theme.duration-normal;
        }
    }
}

// ——— Button（Button.vue：variant/size + 图标 + 文本）———
export enum ButtonVariant {
    default,
    ghost,
    outline,
    link,
}

export component Button inherits Rectangle {
    in property <ButtonVariant> variant: ButtonVariant.ghost;
    in property <image> icon;
    in property <string> text;
    in property <length> icon-size: 20px;
    in property <bool> small: false;
    in property <bool> icon-only: false;
    /** 当前页常亮（侧栏导航 active：中性底 + 前景色 + 600） */
    in property <bool> current: false;
    /** HoverGroup 已接管 hover 时抵消自身 hover 底（侧栏/曲目表） */
    in property <bool> suppress-hover: false;
    in property <bool> enabled: true;
    in property <string> tool-tip: "";
    callback clicked;

    min-height: small ? 32px : 40px;
    border-radius: Theme.radius-md;
    // Vue 基类 border: 1px solid transparent；outline 变体上 --border 描边
    border-width: 1px;
    border-color: variant == ButtonVariant.outline ? Theme.border : transparent;
    horizontal-stretch: 0;
    vertical-stretch: 0;
    accessible-role: button;
    accessible-label: text == "" ? tool-tip : text;
    accessible-enabled: enabled;
    accessible-action-default => {
        if (enabled) {
            clicked();
        }
    }

    background: !enabled || suppress-hover ? transparent
        : current ? Theme.muted
        : touch.has-hover ? (variant == ButtonVariant.default ? Theme.primary-hover : Theme.surface-3)
        : variant == ButtonVariant.default ? Theme.primary
        : transparent;
    opacity: enabled ? 1 : 0.5;

    touch := TouchArea {
        enabled: root.enabled;
        mouse-cursor: pointer;
        clicked => {
            root.clicked();
        }
    }

    if tool-tip != "": Tooltip {
        text: @markdown("\{root.tool-tip}");
    }

    HorizontalLayout {
        padding-left: icon-only ? 0 : 12px;
        padding-right: icon-only ? 0 : 12px;
        padding-top: small ? 4px : 8px;
        padding-bottom: small ? 4px : 8px;
        spacing: 8px;
        alignment: icon-only ? LayoutAlignment.center : LayoutAlignment.start;

        if icon-width > 0: AppIcon {
            source: root.icon;
            icon-color: content-color;
            width: root.icon-size;
            height: root.icon-size;
        }

        if text != "": Text {
            text: root.text;
            color: content-color;
            font-size: small ? 13px : 14px;
            font-weight: current ? 600 : 400;
            vertical-alignment: center;
            overflow: elide;
            horizontal-stretch: 1;
        }
    }

    property <color> content-color: variant == ButtonVariant.default ? Theme.primary-foreground
        : current ? Theme.foreground
        : variant == ButtonVariant.link ? Theme.primary
        : Theme.muted-foreground;
    property <length> icon-width: icon.width > 0 ? icon-size : 0px;
}

// ——— TextLink（.text-link 全局类：基色 muted，hover 提亮 foreground，禁下划线）———
export component TextLink inherits Rectangle {
    in property <string> text;
    in property <length> font-size: 13px;
    in property <TextHorizontalAlignment> alignment: TextHorizontalAlignment.left;
    callback clicked;

    height: font-size * 1.5;
    accessible-role: button;
    accessible-label: text;

    ta := TouchArea {
        mouse-cursor: pointer;
        clicked => {
            root.clicked();
        }
    }

    Text {
        width: parent.width;
        text: root.text;
        color: ta.has-hover ? Theme.foreground : Theme.muted-foreground;
        font-size: root.font-size;
        horizontal-alignment: root.alignment;
        vertical-alignment: center;
        overflow: elide;
        animate color {
            duration: Theme.duration-fast;
        }
    }
}

// ——— EqClock：Equalizer 共享时钟 ———
// 所有实例同相位（对齐 Vue 负 delay 的跨实例相位一致）。33ms ≈ 30fps 采样：
// 900ms 摆动周期的视觉足够，且把持续重绘压力压到 debug 构建可承受
// （debug 全场景重绘 ~30fps，16ms 采样只会空转重绘；release 实测 ~200fps）。
// 暂停的 EQ 走 paused 三元分支、不注册对 t 的依赖——无动画时零重绘开销，
// 因此时钟常跑即可，无需播放门控。
// 驱动 Timer 挂在宿主组件上（Slint 的 global 不能有子元素），见 app.slint。
export global EqClock {
    in-out property <duration> t: 0ms;
}

/** EqClock 驱动宿主：AppWindow 挂载一次即可 */
export component EqClockHost inherits Rectangle {
    background: transparent;
    width: 0px;
    height: 0px;

    Timer {
        interval: 33ms;
        triggered => {
            EqClock.t += 33ms;
        }
    }
}

// ——— Equalizer：三根跳动条（正在播放指示，对齐 Vue eq-bounce）———
// Slint 的属性动画只在绑定值变化时触发（恒定绑定永不启动），负 delay 也只是
// 被当作"无延迟"（无错相效果），所以不走 animate：直接按 EqClock 的绝对时间
// 用余弦公式求高度——挂载即处于稳态相位（Vue 负 delay 语义）、暂停即冻结
// （暂停时刻定格，恢复无跳变）。绕底边缩放：柱条 y 锚定容器底边（对应
// transform-origin: bottom + align-items: flex-end），容器裁齐绘制底边。
export component Equalizer inherits Rectangle {
    in property <bool> paused: false;
    in property <color> bar-color: Theme.track-equalizer;

    width: 13px;
    height: 14px;
    clip: true;

    // 本地相位：暂停期间把 EqClock 的流逝量扣除，冻结在暂停瞬间
    property <duration> offset: 0ms;
    property <duration> frozen: 0ms;
    property <duration> t: root.paused ? root.frozen : EqClock.t - root.offset;

    changed paused => {
        if (self.paused) {
            root.frozen = EqClock.t - root.offset;
        } else {
            root.offset = EqClock.t - root.frozen;
        }
    }

    // scaleY 在 0.55↔1 往返（周期 900ms，三根柱各错相 1/3 周期）；
    // 余弦近似 CSS ease-in-out 的对称半段
    pure function bounce(i: int, ms: float) -> float {
        return 0.775 - 0.225 * Math.cos(360deg * Math.mod(ms + 300 * i, 900) / 900);
    }
    property <float> t-ms: root.t / 1ms;

    // 静态相位基准 60% / 100% / 45%（柱宽 3px，间距 2px）
    Rectangle {
        x: 0;
        width: 3px;
        height: parent.height;

        Rectangle {
            width: parent.width;
            y: parent.height - self.height;
            height: 8px * root.bounce(0, root.t-ms);
            border-radius: 1px;
            background: root.bar-color;
        }
    }
    Rectangle {
        x: 5px;
        width: 3px;
        height: parent.height;

        Rectangle {
            width: parent.width;
            y: parent.height - self.height;
            height: 14px * root.bounce(1, root.t-ms);
            border-radius: 1px;
            background: root.bar-color;
        }
    }
    Rectangle {
        x: 10px;
        width: 3px;
        height: parent.height;

        Rectangle {
            width: parent.width;
            y: parent.height - self.height;
            height: 6px * root.bounce(2, root.t-ms);
            border-radius: 1px;
            background: root.bar-color;
        }
    }
}

// ——— HoverGroup 滑动高亮（HoverGroup.vue 的 Slint 对应物）———
// 组内 HoverItem hover 时把几何（窗口系 absolute-position）上报 HoverBus；
// 组内唯一的块 + 可选 indicator 复制几何并随动滑动。换行瞬间触发黏滞形变：
// 块沿运动主轴拉伸（峰值 1 + min(dist/110, 0.6) * viscosity）、原点钉在运动
// 前缘（前缘贴目标、尾端拖后），240ms 双段 easeOutQuint 回弹到 1——对齐
// Vue triggerStretch；静止时倍率恒 1，圆角精确贴合。
// 归属判定：上报的行几何必须落在组边界内（窗口坐标）——无需 id，多组天然共存。
//
// 关键机制事实（读 i-slint-core-1.17 input.rs / input_items.rs 确证）：
// TouchArea::input_event 对 Moved 事件返回 EventAccepted，会中止向更低兄弟的
// 遍历——has-hover 实际由"命中的最顶层 TouchArea"独占，只沿其祖先链传播。
// 因此 HoverItem 的 TouchArea 必须是行内容的**祖先**（包裹 @children）而非
// 垫底的兄弟；同理组级不再放传感层，离开态由 HoverItem 的自校验退出清理。
export global HoverBus {
    in-out property <Point> item-pos;
    in-out property <length> item-width: 0px;
    in-out property <length> item-height: 0px;
    /** 正在 hover 的行是播放行时压住 indicator（EQ 优先，DESIGN.md §3.0） */
    in-out property <bool> suppress-indicator: false;
    /** 指针仍在某个上报行上（行退出且无新行接管时置 false，收起所有滑块） */
    in-out property <bool> active: false;
    /** 上报序号：hover() 每次 +1，组级 changed 监听用（值不变则 changed 不触发） */
    in-out property <int> report-seq: 0;
    /** 当前命中行所属的组 id（HoverGroup init 时从 next-group-id 领取）。
        归属按组 id 判定而不用几何包含：行与组的 absolute-position 可能来自
        不同布局代际（实测偏差数 px），几何判定会随机失败且会把淡出中的块
        拖去别组的行（混用滑块）。 */
    in-out property <int> active-group: 0;
    in-out property <int> next-group-id: 0;

    // —— 黏滞形变飞行状态（HoverGroup.vue triggerStretch 对应物）———
    // 全局单份：同一时刻只有活跃组在换行飞行；各组的块只在本组活跃时消费，
    // 离开组即视为取消（对齐 hideBlock 的 cancel）。走 240ms 瞬态：先沿运动
    // 主轴拉到峰值（30% 处）再回弹到 1——scale 只在飞行中非 1，静止时圆角
    // 精确贴合。不挂 EqClock（几何依赖常跑时钟会致 30fps 常驻重绘），由
    // 活跃组的 Timer 逐帧推进 fly-t。
    /** 已飞行时长（Timer 逐帧推进）；0 且 !flying = 静止 */
    in-out property <bool> flying: false;
    in-out property <duration> fly-t: 0ms;
    /** 本次飞行的沿轴峰值倍率与运动方向（主轴 + 前缘） */
    in-out property <float> fly-peak: 1.0;
    in-out property <bool> fly-horizontal: true;
    /** 运动前缘：1 = 右/下缘锚定，-1 = 左/上缘，0 = 居中（无该轴分量） */
    in-out property <int> fly-edge-x: 0;
    in-out property <int> fly-edge-y: 0;
    /** 当前瞬态沿轴倍率（静止恒 1；测试观察 + 语义输出口） */
    out property <float> fly-parallel: !root.flying ? 1.0 : root.stretch-at(root.fly-t, root.fly-peak);

    /** 飞行曲线：0→72ms 拉到峰值、72→240ms 回弹，双段 easeOutQuint
        （解析式 1-(1-t)^5，对应 WAAPI 关键帧 cubic-bezier(0.22,1,0.36,1)） */
    public pure function stretch-at(elapsed: duration, peak: float) -> float {
        if (elapsed <= 0ms || elapsed >= 240ms || peak <= 1.0) {
            return 1.0;
        }
        if (elapsed <= 72ms) {
            return 1.0 + (peak - 1.0) * root.ease-out-quint(elapsed / 72ms);
        }
        return 1.0 + (peak - 1.0) * (1.0 - root.ease-out-quint((elapsed - 72ms) / 168ms));
    }

    pure function ease-out-quint(t: float) -> float {
        return 1.0 - Math.pow(1.0 - t, 5.0);
    }

    /** 换行触发形变：from/to 为组本地坐标（只取增量）。峰值为
        1 + min(dist/110, 0.6) * viscosity，原点钉在运动前缘——前缘贴住
        目标、尾端被拖在后面。重入时先归位再拉起（对齐 WAAPI cancel）。 */
    public function trigger-stretch(prev: Point, next: Point, viscosity: float) {
        let fx = (next.x - prev.x) / 1px;
        let fy = (next.y - prev.y) / 1px;
        root.fly-horizontal = Math.abs(fx) >= Math.abs(fy);
        root.fly-edge-x = fx > 0.0 ? 1 : (fx < 0.0 ? -1 : 0);
        root.fly-edge-y = fy > 0.0 ? 1 : (fy < 0.0 ? -1 : 0);
        root.fly-peak = 1.0 + Math.min(Math.sqrt(fx * fx + fy * fy) / 110.0, 0.6) * viscosity;
        root.fly-t = 0ms;
        root.flying = true;
    }

    public function hover(group-id: int, pos: Point, w: length, h: length, suppress: bool) {
        item-pos = pos;
        item-width = w;
        item-height = h;
        suppress-indicator = suppress;
        active-group = group-id;
        active = true;
        report-seq += 1;
    }

    public function leave() {
        active = false;
        // 对齐 Vue hideBlock：收起时取消进行中的形变
        root.flying = false;
        root.fly-t = 0ms;
    }
}

export component HoverGroup inherits Rectangle {
    in property <color> highlight-color: Theme.neutral-300;
    in property <float> highlight-opacity: 0.6;
    /** indicator：随块滑动的悬浮指示（如曲目表序号位的播放图标） */
    in property <image> indicator-icon;
    in property <length> indicator-x: 0px;
    in property <length> indicator-width: 40px;
    in property <length> indicator-icon-size: 16px;
    /** indicator 水平对齐：false=居中（默认），true=居左（曲目表贴序号位） */
    in property <bool> indicator-align-start: false;
    /** 行圆角复制（Vue 逐行复制 computed border-radius；本仓同组内行圆角一致） */
    in property <length> item-radius: 0px;
    /** 黏滞形变强度：越大换行时沿运动轴拉伸越明显（HoverGroup.vue viscosity） */
    in property <float> viscosity: 1.0;
    out property <bool> hovering: has-report;

    public pure function has-indicator() -> bool {
        return indicator-icon.width > 0;
    }

    // 本组实例的唯一 id（init 时从总线领取）；归属判定 = 总线 active-group 是否是它。
    // 不用几何包含判定：行与组的 absolute-position 可能来自不同布局代际
    // （实测偏差数 px），几何判定会随机失败且会把淡出中的块拖去别组的行
    // （混用滑块）。组 id 归属与布局无关。
    in-out property <int> group-id: 0;
    init => {
        HoverBus.next-group-id += 1;
        root.group-id = HoverBus.next-group-id;
    }

    property <bool> has-report: HoverBus.active && HoverBus.active-group == root.group-id;

    // —— 组本地几何（只被 sync-geometry 写入）———
    // 别组上报时本地几何冻结：淡出中的块停在原位，不跟随别组目标（禁混用滑块）
    property <length> geo-x;
    property <length> geo-y;
    property <length> geo-w;
    property <length> geo-h;

    // 首次出现不滑动（块直接跳到位、只做淡入），首次定位后即永久生效
    // （对齐 Vue 版 placed：置位后不再复位，同一轮连续换行也滑动/形变）
    property <bool> placed: false;

    // —— 黏滞形变消费（本组活跃时才跟随总线飞行，其余时刻恒 1）———
    // 淡出中的块（!has-report）不消费飞行：别组紧接着触发的形变不会串到
    // 本组正在消失的块上。
    property <float> parallel-now: root.has-report ? HoverBus.fly-parallel : 1.0;
    property <float> sx: HoverBus.fly-horizontal ? root.parallel-now : 1.0;
    property <float> sy: HoverBus.fly-horizontal ? 1.0 : root.parallel-now;
    property <float> ox: HoverBus.fly-edge-x > 0 ? 1.0 : HoverBus.fly-edge-x < 0 ? 0.0 : 0.5;
    property <float> oy: HoverBus.fly-edge-y > 0 ? 1.0 : HoverBus.fly-edge-y < 0 ? 0.0 : 0.5;

    property <int> bus-seq <=> HoverBus.report-seq;
    changed bus-seq => {
        root.sync-geometry();
    }

    // 形变推进 Timer：只有活跃组且飞行中运行（同时刻至多一个组在飞）；
    // 16ms ≈ 60fps，240ms 飞行共 15 帧，静止时零开销
    Timer {
        interval: 16ms;
        running: root.has-report && HoverBus.flying;
        triggered => {
            if (HoverBus.fly-t + 16ms >= 240ms) {
                HoverBus.flying = false;
                HoverBus.fly-t = 0ms;
            } else {
                HoverBus.fly-t += 16ms;
            }
        }
    }

    function sync-geometry() {
        if (!root.has-report) {
            return;
        }
        let nx = HoverBus.item-pos.x - root.absolute-position.x;
        let ny = HoverBus.item-pos.y - root.absolute-position.y;
        if (root.placed) {
            // 换行触发黏滞形变（首次定位只跳位淡入，不形变）
            HoverBus.trigger-stretch({x: root.geo-x, y: root.geo-y}, {x: nx, y: ny}, root.viscosity);
        }
        root.geo-x = nx;
        root.geo-y = ny;
        root.geo-w = HoverBus.item-width;
        root.geo-h = HoverBus.item-height;
        root.placed = true;
    }

    // 裁掉形变时尾端被拖出组界的部分，保持列表边缘整洁（对齐 Vue overflow: hidden）
    clip: true;

    // 块垫在内容之下（对齐 Vue：内容绘制在 hover-block 之上）。
    // 外层是基准几何（滑动/尺寸动画不动），内层承担黏滞形变：静止时恰好
    // 铺满外层（倍率恒 1，圆角精确贴合），飞行中沿运动主轴放大、原点钉在
    // 运动前缘——前缘贴住目标行，尾端被拖在后面延迟回弹。
    block := Rectangle {
        x: root.geo-x;
        y: root.geo-y;
        width: root.geo-w;
        height: root.geo-h;
        opacity: root.hovering ? root.highlight-opacity : 0;
        animate x {
            duration: 140ms;
            easing: cubic-bezier(0.22, 1, 0.36, 1);
            enabled: root.placed;
        }
        animate y {
            duration: 140ms;
            easing: cubic-bezier(0.22, 1, 0.36, 1);
            enabled: root.placed;
        }
        animate width {
            duration: 180ms;
            easing: cubic-bezier(0.22, 1, 0.36, 1);
            enabled: root.placed;
        }
        animate height {
            duration: 180ms;
            easing: cubic-bezier(0.22, 1, 0.36, 1);
            enabled: root.placed;
        }
        animate opacity {
            duration: Theme.duration-normal;
        }

        Rectangle {
            width: parent.width * root.sx;
            height: parent.height * root.sy;
            x: (parent.width - self.width) * root.ox;
            y: (parent.height - self.height) * root.oy;
            background: root.highlight-color;
            border-radius: root.item-radius;
        }
    }

    @children

    if root.has-indicator(): Rectangle {
        x: root.indicator-x;
        y: block.y;
        width: root.indicator-width;
        height: block.height;
        opacity: root.hovering && !HoverBus.suppress-indicator ? 1 : 0;
        animate opacity {
            duration: Theme.duration-normal;
        }

        AppIcon {
            source: root.indicator-icon;
            icon-color: Theme.foreground;
            width: root.indicator-icon-size;
            height: root.indicator-icon-size;
            x: root.indicator-align-start ? 0 : (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
        }
    }
}

/** hover-item：行级 hover 传感 + 上报几何（HoverItem.vue）
    TouchArea 包住 @children 作祖先：hover 沿最顶层命中的祖先链传播到位；
    行内更深的按钮仍各自拿 grab，互不抢行 hover。整行点击由 clicked 回调
    提供（命中按钮时按钮优先，不会触发行点击）。 */
export component HoverItem inherits Rectangle {
    in property <bool> suppress-indicator: false;
    /** 所属 HoverGroup 的 id（使用方以 hg.group-id 传入） */
    in property <int> group-id: -1;
    callback clicked;
    out property <bool> hovered: item-touch.has-hover;
    background: transparent;

    // 退出自校验的坐标快照：只有总线里仍是自己上次上报的几何时才收起，
    // 否则相邻行滑动时旧行的 Exit（晚于新行的 report 派发）会误清总线
    property <Point> reported-pos;
    property <length> reported-w: 0px;
    property <length> reported-h: 0px;

    // TouchArea 不在布局中时默认 100% 填满父元素（builtins.slint）；
    // 内容必须挂在 TouchArea **之内**（祖先关系），否则行内按钮会以
    // 最顶层命中截断遍历，行级 hover 收不到
    item-touch := TouchArea {
        mouse-cursor: pointer;
        clicked => {
            root.clicked();
        }

        changed has-hover => {
            if (self.has-hover) {
                HoverBus.hover(root.group-id, root.absolute-position, root.width, root.height, root.suppress-indicator);
                root.reported-pos = root.absolute-position;
                root.reported-w = root.width;
                root.reported-h = root.height;
            } else if (HoverBus.active
                && HoverBus.item-pos == root.reported-pos
                && HoverBus.item-width == root.reported-w
                && HoverBus.item-height == root.reported-h) {
                HoverBus.leave();
            }
        }

        VerticalLayout {
            // 行内容块垂直居中（对应 Vue 行 flex align-items: center）：
            // 内容块按首选高布局、默认顶放，定高子元素（队列抽屉 36px 封面）
            // 不足行高时整块会贴住行顶——队列抽屉 49px 行即此症状
            alignment: LayoutAlignment.center;
            @children
        }
    }
}

// ——— Scroll：Flickable + 自绘覆盖滚动条（Scroll.vue）———
// thumb 滚动/悬停/拖拽时亮起，停止交互 900ms 后淡出；hide-scrollbar 时不渲染 thumb。
// 内容放 @children（纵排），viewport 高度取内容 preferred-height。
export component Scroll inherits Rectangle {
    in property <bool> hide-scrollbar: false;
    /** 用户主动滚动（拖拽 thumb / 内容拖拽）——播放页歌词跟随暂停用 */
    callback user-scroll();
    out property <length> view-height: flick.height;

    clip: true;
    background: transparent;

    flick := Flickable {
        x: 0;
        y: 0;
        width: parent.width;
        height: parent.height;
        // 纵向滚动：视口宽固定为自身宽（默认绑定取内容最小宽会成环）
        viewport-width: self.width;
        viewport-height: content.preferred-height;

        content := VerticalLayout {
            @children
        }
    }

    /** 观察滚动位置（changed 只能挂自身属性，走别名）；播放页歌词弹簧
     * 需要程序化回写视口，对外可写（in-out） */
    in-out property <length> scroll-offset <=> flick.viewport-y;
    /** 内容全高（弹簧 clamp 的滚动上限 = self - view-height） */
    out property <length> content-height: flick.viewport-height;
    property <bool> thumb-active: false;
    property <length> scrollable: max(flick.viewport-height - flick.height, 0px);
    property <length> thumb-h: scrollable <= 0px ? flick.height
        : min(flick.height, max(flick.height * flick.height / flick.viewport-height, 24px));
    property <length> thumb-y: scrollable <= 0px ? 0px
        : (-flick.viewport-y) * (flick.height - thumb-h) / scrollable;

    function wake() {
        thumb-active = true;
        hide-timer.restart();
    }

    hide-timer := Timer {
        interval: 900ms;
        running: false;
        triggered => {
            thumb-active = false;
        }
    }

    changed scroll-offset => {
        wake();
    }
    // 命中条：固定几何（不随 thumb 移动）——拖拽参考系必须静止，mouse-y 才能被
    // 1:1 映射回 viewport；TouchArea 若放进 thumb（会移动）内，mouse-y 相对坐标
    // 随之漂移，稳态下 thumb 只以半速跟随、越拖越脱节。比 thumb 宽一点好抓，
    // 无 scroll_event 处理（默认 Reject），滚轮穿透给 Flickable。
    if !hide-scrollbar && scrollable > 0px: Rectangle {
        // 条件元素无默认填充语义，必须显式撑满宿主——里面 track-touch 的
        // parent.width/height 都以它为基准
        width: parent.width;
        height: parent.height;

        track-touch := TouchArea {
            x: parent.width - self.width;
            y: 0;
            width: 10px;
            height: parent.height;

            // 按下时指针相对 thumb 顶的偏移（钳在 thumb 内），拖拽中保持抓取点
            property <length> grab-offset: 0px;

            pointer-event(event) => {
                if (event.kind == PointerEventKind.down) {
                    // 点击轨道即定位：thumb 中心吸附到指针处（overlay 滚动条惯例），
                    // 随后按抓取点 1:1 拖拽——不吸附的话抓取点被钳进 thumb，
                    // 第一次移动会出现跳变
                    flick.viewport-y = -clamp(
                            self.mouse-y - root.thumb-h / 2,
                            0px,
                            flick.height - root.thumb-h,
                        ) * root.scrollable / (flick.height - root.thumb-h);
                    grab-offset = self.mouse-y - root.thumb-y;
                    root.user-scroll();
                    root.wake();
                }
            }
            moved => {
                if (root.scrollable > 0px && flick.height > root.thumb-h) {
                    flick.viewport-y = -clamp(
                            self.mouse-y - grab-offset,
                            0px,
                            flick.height - root.thumb-h,
                        ) * root.scrollable / (flick.height - root.thumb-h);
                }
                root.wake();
            }
        }

        // thumb 纯视觉（拖拽命中在 track-touch），hover/拖拽中常亮
        Rectangle {
            x: parent.width - self.width;
            y: thumb-y;
            width: 6px;
            height: thumb-h;
            border-radius: 3px;
            background: Theme.neutral-600;
            opacity: track-touch.has-hover ? 0.85 : thumb-active ? 0.7 : 0;
            animate opacity {
                duration: Theme.duration-fast;
            }
        }
    }
}
