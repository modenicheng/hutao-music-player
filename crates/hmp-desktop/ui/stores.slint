// 应用状态 globals（player.ts / qualityStore.ts 的 Slint 对应物）。
// 状态属性由 Rust 权威写入；回调发命令给 Rust（模拟播放桥，M8 换真实后端）。
import { TrackRow, CoverCardData, FolderRow, PlaylistCover, LyricRow, CommentRow, TopCardData, TopGroupData } from "data.slint";
import { Theme } from "theme.slint";

export global Player {
    // —— 播放状态快照（PlayerStateSnapshot）———
    in-out property <bool> has-track: false;
    in-out property <bool> playing: false;
    /** 0..1，Rust 权威写入；拖拽中冻结（seeking=true 期间 Rust 不回写） */
    in-out property <float> progress: 0.0;
    /** 主进度条拖拽中：UI 显示 drag-progress（纯本地回显），Rust 暂停 daemon 进度回写 */
    in-out property <bool> seeking: false;
    /** 拖拽中的本地进度 0..1（仅 seeking=true 时有意义） */
    in-out property <float> drag-progress: 0.0;
    in-out property <int> position-ms: 0;
    in-out property <int> duration-ms: 0;
    in-out property <float> volume: 1.0;
    in-out property <bool> can-previous: false;
    in-out property <bool> can-next: false;
    in-out property <string> title: "";
    in-out property <string> artists: "";
    /** 专辑名（播放页 meta 展示；无专辑数据为空串） */
    in-out property <string> album: "";
    in-out property <image> cover;
    /** 环境层模糊底图（Rust 预烘焙：降采样+盒滤波+增饱和，等效 CSS blur+saturate；
        空图 = 无环境层；随封面/换曲更新） */
    in-out property <image> ambient-cover;
    in-out property <string> track-quality: "";
    /** 曲目最高音质档（0=标准 1=高清 2=无损 3=Hi-Res），Rust 从 quality 文案推导 */
    in-out property <int> track-max-tier: 0;
    /** 当前曲源键（QQ mid / local: 路径；异步封面回包按此复核防串台） */
    in-out property <string> current-mid: "";
    /** 引擎装载中（Resolving/Loading）：主播放键等交互的中间态依据 */
    in-out property <bool> loading: false;
    /** 操作反馈（命令被拒/离线/装载失败时 Rust 写入，4s 自动清空；空串不显示） */
    in-out property <string> feedback: "";

    // —— UI 状态（overlay / 抽屉）———
    in-out property <bool> overlay-visible: false;
    in-out property <bool> queue-visible: false;

    // —— 队列 ———
    in-out property <[TrackRow]> queue;
    in-out property <string> queue-current-mid: "";
    /** 抽屉元信息（Rust 侧格式化）："13 首 · 58 分钟" */
    in-out property <string> queue-meta: "";

    // —— 播放模式（daemon 权威写入；切换命令经 daemon 推送回显，不做本地乐观态）———
    /** 循环模式：0=顺序播放 1=单曲循环 2=列表循环。
        注意：与 hmp_core::LoopMode 枚举序（None/List/Track）不同，映射见 player_bridge.rs */
    in-out property <int> loop-mode: 0;
    /** 循环模式三态切换：顺序 → 单曲循环 → 列表循环 → 顺序 */
    callback cycle-loop-mode();
    /** 随机播放（daemon playback.shuffle） */
    in-out property <bool> shuffle: false;
    callback toggle-shuffle();

    // —— 命令 ———
    callback toggle-play();
    callback next();
    callback previous();
    /** 用传入曲目替换队列并从 startIndex 播（playTracks） */
    callback play-tracks([TrackRow], int);
    callback play-at(int);
    /** 按曲目 mid 直接播（在线内容卡片点击；Rust 侧解析为 Play 请求） */
    callback play-mid(string);
    callback remove-at(int);
    callback clear-queue();
    callback seek-percent(float);
    /** 精确到时间的 seek（歌词行/词点击；毫秒，daemon 秒粒度取整） */
    callback seek-ms(int);
    callback set-volume(float);
    /** 播放列表开关语义：开着时再点即收起 */
    callback toggle-queue();
    callback hide-queue();
    callback show-overlay();
    callback hide-overlay();
}

// 音质档位（qualityStore.ts）：mock 期固定四档
export global Quality {
    /** 用户偏好（0=标准 1=高清 2=无损 3=Hi-Res），默认无损 */
    in-out property <int> selected: 2;
    callback select(int);

    public pure function effective(max-tier: int) -> int {
        if (selected <= max-tier) {
            return selected;
        }
        return max-tier;
    }

    public pure function tier-label(tier: int) -> string {
        return tier == 0 ? "标准" : tier == 1 ? "高清" : tier == 2 ? "无损" : "Hi-Res";
    }

    public pure function tier-detail(tier: int) -> string {
        return tier == 0 ? "128kbps MP3"
            : tier == 1 ? "320kbps MP3"
            : tier == 2 ? "FLAC · 44.1kHz"
            : "FLAC · 96kHz/24bit";
    }
}

// 页面数据模型（lib/api 的 mock 层对应物；Rust 装载，页面只读。
// 统计/格式化字段在 Rust 侧算好，Slint 不做数字格式化）
export global Data {
    // —— 我喜欢页 ——
    in-out property <[TrackRow]> liked;
    in-out property <int> liked-count;
    in-out property <int> playlist-count;
    in-out property <[CoverCardData]> created-playlists;
    in-out property <[CoverCardData]> favorited-playlists;
    // —— 侧栏歌单区（宽侧栏分组/窄边栏二级共用同一份真歌单）———
    in-out property <[PlaylistCover]> sidebar-created;
    in-out property <[PlaylistCover]> sidebar-favorited;
    // —— 最近播放页 ——
    in-out property <[TrackRow]> recent;
    in-out property <int> recent-count;
    in-out property <string> recent-latest;
    in-out property <string> recent-earliest;
    // —— 音乐库（本地）——
    in-out property <[TrackRow]> local-tracks;
    in-out property <[FolderRow]> folders;
    in-out property <int> local-count;
    in-out property <string> local-duration;
    in-out property <string> local-size;
    /** 当前过滤的文件夹行（-1 = 全部）；点击同一行再次过滤即取消 */
    in-out property <int> selected-folder: -1;
    in-out property <string> local-table-title: "全部音乐";
    callback filter-folder(int);
    // —— 下载页 ——
    in-out property <[TrackRow]> downloads;
    in-out property <int> downloads-count;
    in-out property <string> downloads-size;
    in-out property <int> downloads-lossless;
    in-out property <string> downloads-storage-path;
    // —— 已购页 ——
    in-out property <[TrackRow]> purchased-singles;
    in-out property <[CoverCardData]> purchased-albums;
    in-out property <int> purchased-single-count;
    in-out property <int> purchased-album-count;
    in-out property <string> purchased-total;
    // —— 歌单详情页（导航时装载；found=false → 诚实"未找到"空态）———
    in-out property <bool> playlist-found: false;
    in-out property <string> playlist-name: "";
    in-out property <[string]> playlist-meta-items;
    in-out property <image> playlist-cover;
    in-out property <[TrackRow]> playlist-tracks;
    // —— 专辑详情页（参数 = 专辑名，本地投影）———
    in-out property <bool> album-found: false;
    in-out property <string> album-name: "";
    /** 歌手链接参数（本地投影 = 歌手名；空串禁用链接） */
    in-out property <string> album-artist: "";
    in-out property <[string]> album-meta-items;
    in-out property <image> album-cover;
    in-out property <[TrackRow]> album-tracks;
    // —— 歌手详情页（参数 = 歌手名，本地投影）———
    in-out property <bool> artist-found: false;
    in-out property <string> artist-name: "";
    in-out property <[string]> artist-meta-items;
    in-out property <image> artist-photo;
    in-out property <[TrackRow]> artist-tracks;
    in-out property <[CoverCardData]> artist-albums;
    // —— 搜索页（daemon Search IPC；时长 smartbox 不回 → 表格隐藏时长列）———
    /** 0=初始 1=搜索中 2=有结果 3=无结果 4=失败 */
    in-out property <int> search-state: 0;
    in-out property <string> search-query: "";
    in-out property <[TrackRow]> search-results;
    in-out property <int> search-count: 0;
    callback search(string);
    // —— 账号（设置页；daemon AccountStatus IPC）———
    /** 0=读取中 1=已读 2=离线失败（daemon 不可达，区别于未登录） */
    in-out property <int> account-state: 0;
    in-out property <bool> account-logged-in: false;
    in-out property <string> account-nickname: "";
    in-out property <string> account-uin: "";
    in-out property <string> account-vip: "";

    // —— M4 在线内容页（daemon DiscoverGet/TopCategoryGet/TopDetailGet/GuessGet）———
    /** 发现页状态：0=初始 1=加载中 2=有内容 3=空 4=失败 */
    in-out property <int> discover-state: 0;
    in-out property <[CoverCardData]> discover-playlists;
    in-out property <bool> discover-has-more: false;
    in-out property <[TrackRow]> discover-new-songs;
    callback refresh-discover();

    /** 排行榜分类状态：0=初始 1=加载中 2=有内容 3=空 4=失败 */
    in-out property <int> top-state: 0;
    in-out property <[TopGroupData]> top-groups;
    callback refresh-top();

    /** 排行榜详情状态（Nav.param 携带 top id）：0=初始 1=加载中 2=有内容 3=空 4=失败 */
    in-out property <int> top-detail-state: 0;
    in-out property <bool> top-detail-found: false;
    in-out property <string> top-detail-name: "";
    in-out property <string> top-detail-update: "";
    in-out property <int> top-detail-total: 0;
    in-out property <[TrackRow]> top-detail-tracks;

    /** 猜你喜欢状态（需登录）：0=初始 1=加载中 2=有内容 3=空 4=失败 */
    in-out property <int> guess-state: 0;
    in-out property <[TrackRow]> guess-tracks;
    in-out property <[CoverCardData]> guess-cards;
    callback refresh-guess();
}

// 播放页 overlay 数据（NowPlayingBody.vue 的对应物；Rust 权威写入）。
// 歌词跟随弹簧/景深在 now-playing.slint 页内自算，只消费 active-line。
export global NowPlaying {
    // —— 歌词（LyricGet IPC → lyrics.rs 解析）———
    in-out property <[LyricRow]> lyrics;
    in-out property <bool> lyrics-loading: false;
    /** 换词表代际（Rust 每次重设模型 +1；页内弹簧据此直达当前行） */
    in-out property <int> lyrics-generation: 0;
    /** 当前播放行下标（Rust 每次状态推送按 position 折算；-1 = 前奏/无歌词） */
    in-out property <int> active-line: -1;

    // —— 评论（CommentList IPC；QQ 曲目专属，本地曲空态）———
    in-out property <[CommentRow]> comments;
    /** 0=未加载 1=加载中 2=就绪 3=失败 */
    in-out property <int> comment-state: 0;
    /** 头部总数文案（"1.2万"），Rust 格式化 */
    in-out property <string> comment-total: "";
    /** 0=最热 1=最新；切换经 request-comments 重拉 */
    in-out property <int> comment-sort: 0;
    callback request-comments();

    // —— 喜欢（mock 态：换曲回落未点亮，与原型一致）———
    in-out property <bool> liked: false;
    callback toggle-liked();
}

// —— 曲目层动态调色（Vue trackTheme.ts + lib/color 取色管线的对应物，M6）——
// Rust 取色模块（src/track_theme.rs）随当前曲封面 + 主题明暗权威写入整族；
// 默认值 = 品牌胡桃木（与 Theme.track-* 同源同值）。
// 作用域纪律对齐 Vue：--track-* 只注入播放页 overlay 子树，主界面永远消费
// 品牌回退——双上下文组件（QualityBadge / VolumeControl / QueueDrawer 在主界面
// 与 overlay 两处复用）经 ctx-* 按上下文取色；纯主界面组件继续读
// Theme.track-*（静态品牌，永不被运行时覆写）。
export global TrackPalette {
    // —— 取色结果（Rust 写入；无封面 / 灰阶封面 = 品牌回退族）———
    in-out property <color> accent: Theme.accent;
    in-out property <color> on-accent: Theme.dark ? #12100D : #FFFFFF;
    in-out property <color> accent-soft: Theme.dark ? Theme.accent.transparentize(0.8) : Theme.accent.transparentize(0.88);
    in-out property <color> deep: Theme.dark ? #2B1A17 : #6B302A;
    in-out property <color> deep-fg: #F7F0EA;
    in-out property <color> grad-from: Theme.dark ? #241A19 : #F3E2DE;
    in-out property <color> grad-to: Theme.dark ? #181412 : #FAF9F8;
    in-out property <color> on-ambient: Theme.dark ? #FAF9F8 : #342827;
    /** true = 当前为品牌回退（无专辑色） */
    in-out property <bool> is-fallback: true;

    // —— 双上下文解析：overlay 打开 → 跟专辑色；主界面 → 品牌胡桃木 ——
    out property <color> ctx-accent: Player.overlay-visible ? accent : Theme.track-accent;
    out property <brush> ctx-accent-soft: Player.overlay-visible ? accent-soft : Theme.track-accent-soft;
    out property <color> ctx-deep: Player.overlay-visible ? deep : Theme.track-deep;
    out property <color> ctx-deep-fg: Player.overlay-visible ? deep-fg : Theme.track-deep-fg;
}
